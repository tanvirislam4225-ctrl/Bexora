    function isValidSellerFollow(data) {
      return data.keys().hasAll([
          'followerId', 'sellerId', 'sellerName', 'sellerUsername',
          'sellerVerified', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'followerId', 'sellerId', 'sellerName', 'sellerUsername',
          'sellerAvatarUrl', 'sellerVerified', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.followerId)
        && isValidId(data.sellerId)
        && data.followerId != data.sellerId
        && data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80
        && data.sellerUsername is string && data.sellerUsername.size() >= 1 && data.sellerUsername.size() <= 40
        && (!('sellerAvatarUrl' in data) || isSafeImageOrHttpsOrEmpty(data.sellerAvatarUrl, 350000))
        && data.sellerVerified is bool
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiAuditReport(data, reportId) {
      return data.keys().hasAll([
          'reportId', 'trigger', 'generatedAtMs', 'durationMs', 'timezone',
          'dateKey', 'overallStatus', 'executiveSummary', 'completedChecksCount',
          'incompleteChecksCount', 'openIssuesCount', 'newlyDiscoveredCount',
          'fixedVerifiedCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reportId', 'trigger', 'generatedAtMs', 'durationMs', 'timezone',
          'dateKey', 'overallStatus', 'executiveSummary', 'completedChecksCount',
          'incompleteChecksCount', 'openIssuesCount', 'newlyDiscoveredCount',
          'fixedVerifiedCount', 'createdAt', 'updatedAt'
        ])
        && data.reportId == reportId
        && isValidId(data.reportId)
        && data.trigger in ['manual', 'scheduled_daily']
        && data.generatedAtMs is int && data.generatedAtMs >= 0
        && data.durationMs is int && data.durationMs >= 0
        && data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 64
        && data.dateKey is string && data.dateKey.size() == 10
        && data.overallStatus in ['healthy', 'attention_needed', 'critical_issues', 'incomplete']
        && data.executiveSummary is string && data.executiveSummary.size() >= 1 && data.executiveSummary.size() <= 2000
        && data.completedChecksCount is int && data.completedChecksCount >= 0
        && data.incompleteChecksCount is int && data.incompleteChecksCount >= 0
        && data.openIssuesCount is int && data.openIssuesCount >= 0
        && data.newlyDiscoveredCount is int && data.newlyDiscoveredCount >= 0
        && data.fixedVerifiedCount is int && data.fixedVerifiedCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiConversation(data) {
      return data.keys().hasAll([
          'title', 'createdBy', 'messageCount', 'lastMessagePreview',
          'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'summary', 'createdBy', 'messageCount', 'lastMessagePreview',
          'pinnedReportId', 'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 400))
        && isValidId(data.createdBy)
        && data.messageCount is int && data.messageCount >= 0
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240
        && (!('pinnedReportId' in data) || (data.pinnedReportId is string && data.pinnedReportId.size() <= 128))
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.updatedAtMs is int && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiConversationMessage(data, conversationId) {
      return data.keys().hasAll([
          'conversationId', 'role', 'content', 'evidenceMode', 'createdAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'conversationId', 'role', 'content', 'evidenceMode',
          'modelUsed', 'actorUid', 'createdAtMs', 'createdAt'
        ])
        && data.conversationId == conversationId
        && isValidId(data.conversationId)
        && data.role in ['admin', 'assistant']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 12000
        && data.evidenceMode in ['verified_project_evidence', 'live_tool_inspection', 'general_reasoning']
        && (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 80))
        && (!('actorUid' in data) || (data.actorUid is string && data.actorUid.size() <= 128))
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.createdAt is timestamp;
    }

    function isValidAiDailySchedule(data) {
      return data.keys().hasAll([
          'enabled', 'hour', 'minute', 'timezone',
          'notifyInApp', 'notifyTelegram', 'notifyEmail',
          'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'enabled', 'hour', 'minute', 'timezone',
          'notifyInApp', 'notifyTelegram', 'notifyEmail',
          'updatedBy', 'updatedAt'
        ])
        && data.enabled is bool
        && data.hour is int && data.hour >= 0 && data.hour <= 23
        && data.minute is int && data.minute >= 0 && data.minute <= 59
        && data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 64
        && data.notifyInApp is bool
        && data.notifyTelegram is bool
        && data.notifyEmail is bool
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidRecentSearch(data, uid) {
      return data.keys().hasAll([
          'uid', 'query', 'platform', 'subcategory', 'monetization',
          'verifiedOnly', 'sortBy', 'summaryLabel', 'searchedAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'query', 'platform', 'subcategory', 'monetization',
          'verifiedOnly', 'sortBy', 'summaryLabel', 'searchedAtMs', 'updatedAt'
        ])
        && data.uid == uid
        && data.query is string && data.query.size() <= 120
        && data.platform in ['all', 'youtube', 'facebook', 'instagram', 'tiktok', 'telegram', 'website', 'domain', 'gaming']
        && data.subcategory is string && data.subcategory.size() <= 80
        && data.monetization in ['all', 'monetized', 'non-monetized']
        && data.verifiedOnly is bool
        && data.sortBy in ['newest', 'price_asc', 'price_desc', 'revenue_desc']
        && data.summaryLabel is string && data.summaryLabel.size() >= 1 && data.summaryLabel.size() <= 180
        && data.searchedAtMs is int && data.searchedAtMs >= 0
        && data.updatedAt is timestamp;
    }

    function isValidPublicActivity(data) {
      return data.keys().hasAll([
          'kind', 'actorDisplayName', 'actorVerified',
          'amountMinor', 'currency', 'completedAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'kind', 'actorDisplayName', 'actorVerified', 'assetTitle', 'platform',
          'amountMinor', 'currency', 'completedAtMs', 'createdAt'
        ])
        && data.kind in ['sold', 'payout']
        && data.actorDisplayName is string && data.actorDisplayName.size() >= 2 && data.actorDisplayName.size() <= 80
        && data.actorVerified is bool
        && (!('assetTitle' in data) || (data.assetTitle is string && data.assetTitle.size() >= 2 && data.assetTitle.size() <= 120))
        && (!('platform' in data) || data.platform in ['youtube', 'facebook', 'instagram', 'tiktok', 'telegram', 'website', 'domain', 'gaming'])
        && data.amountMinor is int && data.amountMinor > 0
        && data.currency in ['BDT', 'USD']
        && data.completedAtMs is int && data.completedAtMs > 0
        && data.createdAt is timestamp;
    }

    function isValidReviewReport(data) {
      return data.keys().hasAll([
          'reviewId', 'dealId', 'reporterId', 'reporterName',
          'reason', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reviewId', 'dealId', 'reporterId', 'reporterName',
          'reason', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.reviewId)
        && isValidId(data.dealId)
        && isValidId(data.reporterId)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80
        && data.reason is string && data.reason.size() >= 8 && data.reason.size() <= 600
        && data.status in ['open', 'dismissed', 'hidden']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserRestriction(data, uid) {
      return data.keys().hasAll([
          'userId', 'accountStatus', 'activeStrikes', 'totalHistoricalStrikes',
          'restrictListings', 'restrictBidding', 'restrictPurchasing',
          'restrictPreDealChat', 'restrictDealChat', 'restrictReviews',
          'restrictProfileEdits', 'restrictWithdrawals', 'financialHoldActive',
          'requiresHumanPermanentBanReview', 'reason', 'enforcedBy', 'expiresAtMs',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'accountStatus', 'activeStrikes', 'totalHistoricalStrikes',
          'latestWarningTitle', 'latestWarningMessage', 'latestCategory',
          'restrictListings', 'restrictBidding', 'restrictPurchasing',
          'restrictPreDealChat', 'restrictDealChat', 'restrictReviews',
          'restrictProfileEdits', 'restrictWithdrawals', 'financialHoldActive',
          'requiresHumanPermanentBanReview', 'reason', 'enforcedBy', 'expiresAtMs',
          'createdAt', 'updatedAt'
        ])
        && data.userId == uid
        && data.accountStatus in [
          'active', 'warned', 'restricted', 'temporary_suspension', 'protective_suspension', 'permanent_ban'
        ]
        && data.activeStrikes is int && data.activeStrikes >= 0 && data.activeStrikes <= 3
        && data.totalHistoricalStrikes is int && data.totalHistoricalStrikes >= 0
        && (!('latestWarningTitle' in data) || (data.latestWarningTitle is string && data.latestWarningTitle.size() <= 200))
        && (!('latestWarningMessage' in data) || (data.latestWarningMessage is string && data.latestWarningMessage.size() <= 1200))
        && (!('latestCategory' in data) || (data.latestCategory is string && data.latestCategory.size() <= 64))
        && data.restrictListings is bool
        && data.restrictBidding is bool
        && data.restrictPurchasing is bool
        && data.restrictPreDealChat is bool
        && data.restrictDealChat is bool
        && data.restrictReviews is bool
        && data.restrictProfileEdits is bool
        && data.restrictWithdrawals is bool
        && data.financialHoldActive is bool
        && data.requiresHumanPermanentBanReview is bool
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 600
        && data.enforcedBy in ['ai_protective_system', 'human_admin']
        && data.expiresAtMs is int && data.expiresAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserReport(data) {
      return data.keys().hasAll([
          'trackingRef', 'reporterId', 'reporterName', 'reportedUserId',
          'reportedUserName', 'category', 'surface', 'description',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trackingRef', 'reporterId', 'reporterName', 'reportedUserId',
          'reportedUserName', 'category', 'surface', 'description',
          'status', 'assignedAdminId', 'resolutionSummaryForReporter',
          'createdAt', 'updatedAt'
        ])
        && data.trackingRef is string && data.trackingRef.size() >= 6 && data.trackingRef.size() <= 32
        && isValidId(data.reporterId)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 100
        && isValidId(data.reportedUserId)
        && data.reportedUserName is string && data.reportedUserName.size() >= 1 && data.reportedUserName.size() <= 100
        && data.category is string && data.category.size() >= 3 && data.category.size() <= 64
        && data.surface is string && data.surface.size() >= 3 && data.surface.size() <= 64
        && data.description is string && data.description.size() >= 15 && data.description.size() <= 3000
        && data.status in ['submitted', 'under_review', 'action_taken', 'dismissed', 'needs_info']
        && (!('assignedAdminId' in data) || isValidId(data.assignedAdminId))
        && (!('resolutionSummaryForReporter' in data) || (data.resolutionSummaryForReporter is string && data.resolutionSummaryForReporter.size() <= 600))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccountAppeal(data) {
      return data.keys().hasAll([
          'trackingRef', 'userId', 'userName', 'explanation', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trackingRef', 'userId', 'userName', 'explanation', 'supportingContext',
          'status', 'adminDecisionNote', 'reviewedByAdminId', 'createdAt', 'updatedAt'
        ])
        && data.trackingRef is string && data.trackingRef.size() >= 6 && data.trackingRef.size() <= 32
        && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100
        && data.explanation is string && data.explanation.size() >= 20 && data.explanation.size() <= 3500
        && (!('supportingContext' in data) || (data.supportingContext is string && data.supportingContext.size() <= 1500))
        && data.status in ['pending', 'under_review', 'accepted', 'rejected', 'info_requested']
        && (!('adminDecisionNote' in data) || (data.adminDecisionNote is string && data.adminDecisionNote.size() <= 1000))
        && (!('reviewedByAdminId' in data) || isValidId(data.reviewedByAdminId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidModerationAlert(data) {
      return data.keys().hasAll([
          'eventKey', 'priority', 'decisionLevel', 'status', 'surface',
          'category', 'userId', 'rawContent', 'aiReasoning', 'protectiveActionTaken',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'eventKey', 'priority', 'decisionLevel', 'status', 'surface',
          'category', 'userId', 'rawContent', 'aiReasoning', 'protectiveActionTaken',
          'humanFinalDecision', 'createdAt', 'updatedAt'
        ])
        && data.eventKey is string && data.eventKey.size() >= 1 && data.eventKey.size() <= 128
        && data.priority in ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW']
        && data.decisionLevel in ['LEVEL_A', 'LEVEL_B', 'LEVEL_C', 'CLEAN']
        && data.status in ['open', 'investigating', 'resolved', 'false_positive', 'escalated']
        && data.surface is string && data.surface.size() <= 64
        && data.category is string && data.category.size() <= 64
        && isValidId(data.userId)
        && data.rawContent is string && data.rawContent.size() <= 3000
        && data.aiReasoning is string && data.aiReasoning.size() <= 600
        && data.protectiveActionTaken is string && data.protectiveActionTaken.size() <= 500
        && (!('humanFinalDecision' in data) || (data.humanFinalDecision is string && data.humanFinalDecision.size() <= 600))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidModerationAuditLog(data) {
      return data.keys().hasAll([
          'actorType', 'actorId', 'targetUserId', 'actionType', 'reason', 'createdAt'
        ])
        && data.keys().hasOnly([
          'actorType', 'actorId', 'targetUserId', 'actionType', 'reason', 'createdAt'
        ])
        && data.actorType in ['ai_protective_system', 'human_admin', 'human_superadmin']
        && isValidId(data.actorId)
        && isValidId(data.targetUserId)
        && data.actionType is string && data.actionType.size() >= 3 && data.actionType.size() <= 64
        && data.reason is string && data.reason.size() >= 4 && data.reason.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidListingRevision(data, listingId) {
      return data.keys().hasAll([
          'listingId', 'sellerId', 'previousTitle', 'previousDescription',
          'previousPriceMinor', 'previousCurrency', 'previousStatus',
          'previousImagesCount', 'changeSummary', 'createdAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'listingId', 'sellerId', 'previousTitle', 'previousDescription',
          'previousPriceMinor', 'previousCurrency', 'previousStatus',
          'previousImagesCount', 'changeSummary', 'createdAtMs', 'createdAt'
        ])
        && data.listingId == listingId
        && isValidId(data.sellerId)
        && data.previousTitle is string && data.previousTitle.size() <= 140
        && data.previousDescription is string && data.previousDescription.size() <= 4000
        && data.previousPriceMinor is int && data.previousPriceMinor >= 0
        && data.previousCurrency in ['BDT', 'USD']
        && data.previousStatus is string && data.previousStatus.size() <= 32
        && data.previousImagesCount is int && data.previousImagesCount >= 0 && data.previousImagesCount <= 10
        && data.changeSummary is string && data.changeSummary.size() >= 1 && data.changeSummary.size() <= 600
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.createdAt is timestamp;
    }

    function isValidBannedIdentity(data) {
      return data.keys().hasAll([
          'identityHash', 'kind', 'reason', 'enforcedBy', 'createdAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'identityHash', 'kind', 'reason', 'enforcedBy', 'createdAtMs', 'createdAt'
        ])
        && data.identityHash is string && data.identityHash.size() >= 16 && data.identityHash.size() <= 128 && data.identityHash.matches('^[a-f0-9]+$')
        && data.kind in ['email', 'phone']
        && data.reason is string && data.reason.size() >= 4 && data.reason.size() <= 600
        && isValidId(data.enforcedBy)
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.createdAt is timestamp;
    }

    function isValidUserPresence(data, uid) {
      return data.keys().hasAll(['uid', 'state', 'lastSeenMs', 'activeSessions', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'state', 'lastSeenMs', 'activeSessions', 'updatedAt'])
        && data.uid == uid
        && data.state in ['online', 'offline']
        && data.lastSeenMs is int && data.lastSeenMs > 0
        && data.activeSessions is int && data.activeSessions >= 0
        && data.updatedAt is timestamp;
    }

    function isValidUserPresenceSession(data, uid, sessionId) {
      return data.keys().hasAll(['sessionId', 'uid', 'deviceType', 'state', 'lastHeartbeatAtMs', 'createdAtMs', 'updatedAt'])
        && data.keys().hasOnly(['sessionId', 'uid', 'deviceType', 'state', 'lastHeartbeatAtMs', 'createdAtMs', 'updatedAt'])
        && data.sessionId == sessionId
        && data.uid == uid
        && data.deviceType in ['desktop', 'mobile', 'tablet']
        && data.state in ['online', 'offline']
        && data.lastHeartbeatAtMs is int
        && data.createdAtMs is int
        && data.updatedAt is timestamp;
    }

    function isValidPresenceNode(data) {
      return data.keys().hasAll(['state', 'lastActiveAt'])
        && data.keys().hasOnly(['state', 'lastActiveAt', 'showStatus', 'updatedAt'])
        && data.state in ['online', 'offline']
        && (data.lastActiveAt is int || data.lastActiveAt is float)
        && data.lastActiveAt > 0
        && (!('showStatus' in data) || data.showStatus is bool);
    }

    // 0. Health Connection Test Path (Read-only doc lookup)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // 1. Public Profiles (Public read; strict owner/admin write; badges protected)
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.uid is string || (request.query.limit != null && request.query.limit <= 100);
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPublicProfile(incoming(), userId)
        && incoming().nidVerified == false
        && incoming().completedTrader == false
        && incoming().completedSales == 0
        && incoming().completedPurchases == 0
        && incoming().ratingSum == 0
        && incoming().ratingCount == 0
        && !('lastReviewDealId' in incoming())
        && (!('followerCount' in incoming()) || incoming().followerCount == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            request.auth.uid == userId
            && !isUserModerationSuspended(request.auth.uid)
            && !hasActiveRestrictionFlag(request.auth.uid, 'restrictProfileEdits')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'bio', 'avatarUrl', 'coverUrl',
              'location', 'hidePublicActivityName', 'updatedAt'
            ])
          )
          || (
            // Verified buyer atomically creating settled-deal review rev_{dealId} increments seller ratingSum & ratingCount
            request.auth.uid != userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['ratingSum', 'ratingCount', 'lastReviewDealId', 'updatedAt'])
            && 'lastReviewDealId' in incoming()
            && isValidId(incoming().lastReviewDealId)
            && !exists(/databases/$(database)/documents/reviews/$('rev_' + incoming().lastReviewDealId))
            && existsAfter(/databases/$(database)/documents/reviews/$('rev_' + incoming().lastReviewDealId))
            && getAfter(/databases/$(database)/documents/reviews/$('rev_' + incoming().lastReviewDealId)).data.sellerId == userId
            && getAfter(/databases/$(database)/documents/reviews/$('rev_' + incoming().lastReviewDealId)).data.reviewerId == request.auth.uid
            && incoming().ratingCount == existing().ratingCount + 1
            && incoming().ratingSum == existing().ratingSum + getAfter(/databases/$(database)/documents/reviews/$('rev_' + incoming().lastReviewDealId)).data.score
          )
          || (
            // Non-self follower atomically creating sellerFollows increments seller followerCount by 1
            request.auth.uid != userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['followerCount', 'updatedAt'])
            && !exists(/databases/$(database)/documents/sellerFollows/$('fol_' + request.auth.uid + '_' + userId))
            && existsAfter(/databases/$(database)/documents/sellerFollows/$('fol_' + request.auth.uid + '_' + userId))
            && incoming().followerCount == (('followerCount' in existing() ? existing().followerCount : 0) + 1)
          )
          || (
            // Non-self follower atomically deleting sellerFollows decrements seller followerCount by 1
            request.auth.uid != userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['followerCount', 'updatedAt'])
            && exists(/databases/$(database)/documents/sellerFollows/$('fol_' + request.auth.uid + '_' + userId))
            && !existsAfter(/databases/$(database)/documents/sellerFollows/$('fol_' + request.auth.uid + '_' + userId))
            && incoming().followerCount == (('followerCount' in existing() && existing().followerCount > 0) ? existing().followerCount - 1 : 0)
          )
        );
      allow delete: if isSuperAdmin() && isValidId(userId) && request.auth.uid != userId;
    }

    // 2. Private Users (Strictly owner or admin read/write; wallet balance protected)
    match /privateUsers/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPrivateUser(incoming(), userId)
        && (incoming().emailVerified == false || request.auth.token.email_verified == true)
        && (incoming().phoneVerified == false || request.auth.token.firebase.sign_in_provider == 'phone' || ('phone_number' in request.auth.token && request.auth.token.phone_number is string))
        && incoming().nidStatus == 'not_verified'
        && incoming().walletBalanceMinor == 0
        && incoming().reservedBalanceMinor == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidPrivateUser(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'email', 'phone', 'phoneCountryCode', 'phoneFormatValidated', 'emailVerified', 'phoneVerified', 'nidStatus', 'nidRejectionReason',
              'preferredLanguage', 'preferredCurrency', 'notificationPrefs', 'updatedAt'
            ])
            && (incoming().nidStatus == existing().nidStatus || incoming().nidStatus == 'pending_review')
            && (
              !('nidRejectionReason' in incoming())
              || ('nidRejectionReason' in existing() && incoming().nidRejectionReason == existing().nidRejectionReason)
            )
            && (incoming().emailVerified == existing().emailVerified || (incoming().emailVerified == true && request.auth.token.email_verified == true))
            && (
              incoming().phoneVerified == false
              || (incoming().phoneVerified == existing().phoneVerified && incoming().phone == existing().phone)
              || (incoming().phoneVerified == true && ('phone_number' in request.auth.token && request.auth.token.phone_number is string && request.auth.token.phone_number == incoming().phone))
            )
          )
          || (
            // Atomic wallet debit when purchasing an active listing or reserving a withdrawal
            request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['walletBalanceMinor', 'reservedBalanceMinor', 'updatedAt'])
            && incoming().walletBalanceMinor < existing().walletBalanceMinor
            && (
              (
                incoming().reservedBalanceMinor == existing().reservedBalanceMinor
              )
              || (
                incoming().reservedBalanceMinor > existing().reservedBalanceMinor
                && (incoming().walletBalanceMinor + incoming().reservedBalanceMinor) == (existing().walletBalanceMinor + existing().reservedBalanceMinor)
              )
            )
          )
        );
      allow delete: if isSuperAdmin()
        && isValidId(userId)
        && request.auth.uid != userId
        && existing().walletBalanceMinor == 0
        && existing().reservedBalanceMinor == 0;

      // 2b. Strictly Owner-Private FCM Web Push Registration Tokens
      match /pushTokens/{tokenId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(tokenId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/privateUsers/$(userId));
        allow list: if isSignedIn()
          && isValidId(userId)
          && request.auth.uid == userId
          && resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/privateUsers/$(userId));
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(tokenId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/privateUsers/$(userId))
          && isValidPushToken(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(tokenId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/privateUsers/$(userId))
          && isValidPushToken(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAtMs == existing().createdAtMs
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'token', 'userAgent', 'platform', 'deviceLabel', 'enabled', 'lastRefreshedAtMs', 'updatedAt'
          ]);
        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(tokenId)
          && request.auth.uid == userId;
      }

      // 2c. Strictly Owner-Private Recent Marketplace Searches
      match /recentSearches/{searchId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(searchId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/privateUsers/$(userId));
        allow list: if isSignedIn()
          && isValidId(userId)
          && request.auth.uid == userId
          && resource.data.uid == request.auth.uid;
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(searchId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/privateUsers/$(userId))
          && isValidRecentSearch(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(searchId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/privateUsers/$(userId))
          && isValidRecentSearch(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'query', 'platform', 'subcategory', 'monetization',
            'verifiedOnly', 'sortBy', 'summaryLabel', 'searchedAtMs', 'updatedAt'
          ]);
        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(searchId)
          && request.auth.uid == userId;
      }
    }

    // 3. Global Username Reservations
    match /usernames/{username} {
      allow get: if isValidId(username);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(username)
        && isValidUsernameReservation(incoming(), username)
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(username)
        && isValidUsernameReservation(incoming(), username)
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(username)
        && (existing().uid == request.auth.uid || isAdmin());
    }

    // 4. Admins Registry (Only SuperAdmin can manage roles)
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSuperAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isSuperAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'permissions']);
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 5. Private Identity Verifications (NID Front & Back)
    match /identityVerifications/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidIdentityVerification(incoming(), userId)
        && incoming().status == 'pending_review'
        && incoming().submittedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidIdentityVerification(incoming(), userId)
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            request.auth.uid == userId
            && existing().status == 'rejected'
            && incoming().status == 'pending_review'
            && !('rejectionReason' in incoming())
            && !('reviewedBy' in incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'frontImageData', 'backImageData', 'status', 'rejectionReason', 'reviewedBy', 'submittedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isSuperAdmin() && isValidId(userId) && request.auth.uid != userId;
    }

    // 6. Marketplace Listings
    match /listings/{listingId} {
      allow get: if isValidId(listingId) && (
        resource == null
        || existing().status in ['active', 'reserved', 'sold']
        || (isSignedIn() && (isAdmin() || existing().sellerId == request.auth.uid))
      );
      allow list: if resource.data.status in ['active', 'reserved']
        || (isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn()
        && isValidId(listingId)
        && isValidListing(incoming())
        && incoming().sellerId == request.auth.uid
        && !isUserModerationSuspended(request.auth.uid)
        && !hasActiveRestrictionFlag(request.auth.uid, 'restrictListings')
        && incoming().status in ['draft', 'pending']
        && incoming().verifiedOptions.size() == 0
        && incoming().views == 0
        && !('firstPublishedAtMs' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(listingId)
        && isValidListing(incoming())
        && incoming().sellerId == existing().sellerId
        && incoming().createdAt == existing().createdAt
        && (
          (
            isSignedIn()
            && (
              (
                isAdmin()
                && incoming().updatedAt == request.time
              )
              || (
                // Seller editing own draft/pending/active/rejected/archived listing (never sold/reserved/suspended) resets verifiedOptions to []
                existing().sellerId == request.auth.uid
                && !isUserModerationSuspended(request.auth.uid)
                && !hasActiveRestrictionFlag(request.auth.uid, 'restrictListings')
                && existing().status in ['draft', 'pending', 'active', 'rejected', 'archived']
                && incoming().status in ['draft', 'pending', 'archived']
                && incoming().verifiedOptions.size() == 0
                && incoming().views == existing().views
                && (
                  !('rejectionReason' in incoming())
                  || ('rejectionReason' in existing() && incoming().rejectionReason == existing().rejectionReason)
                )
                && incoming().updatedAt == request.time
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'description', 'priceMinor', 'subcategory', 'monetizationStatus',
                  'claimedOptions', 'verifiedOptions', 'verificationState', 'ageYears', 'ageMonths',
                  'metricValue', 'monthlyRevenueMinor', 'accountUrl', 'urlValidationStatus',
                  'gameName', 'gameUid', 'gameLevel', 'images', 'status', 'rejectionReason', 'updatedAt'
                ])
              )
              || (
                // Seller accepting a bid reserves their own active listing atomically with deal creation
                existing().sellerId == request.auth.uid
                && existing().status == 'active'
                && incoming().status == 'reserved'
                && incoming().activeDealId is string
                && isValidId(incoming().activeDealId)
                && existsAfter(/databases/$(database)/documents/deals/$(incoming().activeDealId))
                && getAfter(/databases/$(database)/documents/deals/$(incoming().activeDealId)).data.listingId == listingId
                && incoming().updatedAt == request.time
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'activeDealId', 'acceptedBidAmountMinor', 'reservedBuyerId', 'updatedAt'
                ])
              )
              || (
                // Seller or reserved buyer safely cancelling an unpaid reservation restores listing to active
                existing().status == 'reserved'
                && existing().activeDealId is string
                && (
                  existing().sellerId == request.auth.uid
                  || ('reservedBuyerId' in existing() && existing().reservedBuyerId == request.auth.uid)
                )
                && incoming().status == 'active'
                && !('activeDealId' in incoming())
                && !('acceptedBidAmountMinor' in incoming())
                && !('reservedBuyerId' in incoming())
                && !exists(/databases/$(database)/documents/walletLedger/$('led_pay_' + existing().activeDealId))
                && getAfter(/databases/$(database)/documents/deals/$(existing().activeDealId)).data.status == 'cancelled'
                && incoming().updatedAt == request.time
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'activeDealId', 'acceptedBidAmountMinor', 'reservedBuyerId', 'updatedAt'
                ])
              )
              || (
                // Buyer completing atomic Buy Now or Reserved Deal Payment transitions listing -> sold
                existing().status in ['active', 'reserved']
                && (existing().status == 'active' || !('reservedBuyerId' in existing()) || existing().reservedBuyerId == request.auth.uid)
                && incoming().status == 'sold'
                && incoming().activeDealId is string
                && (existing().status == 'active' || incoming().activeDealId == existing().activeDealId)
                && existsAfter(/databases/$(database)/documents/deals/$(incoming().activeDealId))
                && getAfter(/databases/$(database)/documents/deals/$(incoming().activeDealId)).data.listingId == listingId
                && getAfter(/databases/$(database)/documents/deals/$(incoming().activeDealId)).data.buyerId == request.auth.uid
                && existsAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + incoming().activeDealId))
                && incoming().updatedAt == request.time
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'activeDealId', 'updatedAt'])
              )
            )
          )
          || (
            // Safe +1 view counter increment (open to all legitimate viewers including guests)
            existing().status in ['active', 'reserved']
            && incoming().views == existing().views + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['views'])
          )
        );
      allow delete: if isSignedIn() && isValidId(listingId) && (
        isAdmin()
        || (
          existing().sellerId == request.auth.uid
          && !isUserModerationSuspended(request.auth.uid)
          && existing().status in ['draft', 'pending', 'active', 'rejected', 'archived']
          && !('activeDealId' in existing() && existing().activeDealId is string && existing().activeDealId.size() > 0)
        )
      );

      // 6b. Immutable Listing Edit Revisions (Master Gate checks parent listing ownership; 0-lookup list rule)
      match /revisions/{revisionId} {
        allow get: if isSignedIn()
          && isValidId(listingId)
          && isValidId(revisionId)
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && (
            isAdmin()
            || get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid
          );
        allow list: if isSignedIn()
          && (
            resource.data.sellerId == request.auth.uid
            || isAdmin()
          );
        allow create: if isSignedIn()
          && isValidId(listingId)
          && isValidId(revisionId)
          && isValidListingRevision(incoming(), listingId)
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && (
            isAdmin()
            || (
              incoming().sellerId == request.auth.uid
              && get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid
            )
          )
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // 7. Private Listing Evidence
    match /listingEvidence/{listingId} {
      allow get: if isSignedIn() && isValidId(listingId) && (
        isAdmin() || (resource != null && existing().sellerId == request.auth.uid)
      );
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(listingId)
        && isValidListingEvidence(incoming(), listingId)
        && incoming().sellerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(listingId)
        && isValidListingEvidence(incoming(), listingId)
        && incoming().sellerId == existing().sellerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().sellerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['evidenceImages', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn()
        && isValidId(listingId)
        && (isAdmin() || existing().sellerId == request.auth.uid)
        && !existsAfter(/databases/$(database)/documents/listings/$(listingId));
    }

    // 8. Role-Based Bids (Never deleted; preserves accepted_pending_payment & paid lifecycle)
    match /bids/{bidId} {
      allow get: if isValidId(bidId);
      allow list: if resource.data.listingId is string
        || (isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn()
        && isValidId(bidId)
        && isValidBid(incoming())
        && incoming().buyerId == request.auth.uid
        && incoming().buyerId != incoming().sellerId
        && !isUserModerationSuspended(request.auth.uid)
        && !hasActiveRestrictionFlag(request.auth.uid, 'restrictBidding')
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/listings/$(incoming().listingId))
        && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status == 'active'
        && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.sellerId == incoming().sellerId;
      allow update: if isSignedIn()
        && isValidId(bidId)
        && isValidBid(incoming())
        && incoming().listingId == existing().listingId
        && incoming().sellerId == existing().sellerId
        && incoming().buyerId == existing().buyerId
        && incoming().amountMinor == existing().amountMinor
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            // Buyer can withdraw their own pending bid
            existing().status == 'pending'
            && existing().buyerId == request.auth.uid
            && incoming().status == 'withdrawn'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            // Seller can reject a pending bid on their listing
            existing().status == 'pending'
            && existing().sellerId == request.auth.uid
            && incoming().status == 'rejected'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            // Seller accepting a pending bid marks accepted_pending_payment and binds exact dealId + baseAmountMinor
            existing().status == 'pending'
            && existing().sellerId == request.auth.uid
            && incoming().status in ['accepted_pending_payment', 'accepted']
            && 'dealId' in incoming()
            && isValidId(incoming().dealId)
            && existsAfter(/databases/$(database)/documents/deals/$(incoming().dealId))
            && getAfter(/databases/$(database)/documents/deals/$(incoming().dealId)).data.baseAmountMinor == existing().amountMinor
            && getAfter(/databases/$(database)/documents/deals/$(incoming().dealId)).data.buyerId == existing().buyerId
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'dealId', 'updatedAt'])
          )
          || (
            // Buyer paying their accepted bid marks bid paid atomically with deterministic payment ledger
            existing().status in ['accepted_pending_payment', 'accepted']
            && existing().buyerId == request.auth.uid
            && incoming().status == 'paid'
            && 'dealId' in existing()
            && incoming().dealId == existing().dealId
            && existsAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + existing().dealId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            // Seller or buyer cancelling an unpaid reservation marks the accepted bid expired
            existing().status in ['accepted_pending_payment', 'accepted']
            && (existing().sellerId == request.auth.uid || existing().buyerId == request.auth.uid)
            && incoming().status == 'expired'
            && 'dealId' in existing()
            && incoming().dealId == existing().dealId
            && !exists(/databases/$(database)/documents/walletLedger/$('led_pay_' + existing().dealId))
            && getAfter(/databases/$(database)/documents/deals/$(existing().dealId)).data.status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // 9. Pre-Deal Messenger Conversations & Messages
    match /conversations/{convId} {
      allow get: if isSignedIn() && isValidId(convId) && (
        resource == null
        || isAdmin()
        || existing().buyerId == request.auth.uid
        || existing().sellerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(convId)
        && isValidConversation(incoming())
        && (incoming().buyerId == request.auth.uid || incoming().sellerId == request.auth.uid)
        && !isUserModerationSuspended(request.auth.uid)
        && !hasActiveRestrictionFlag(request.auth.uid, 'restrictPreDealChat')
        && (!('moderationPaused' in incoming()) || incoming().moderationPaused == false || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(convId)
        && isValidConversation(incoming())
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && incoming().listingId == existing().listingId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            // Standard conversation metadata update when conversation is NOT paused
            (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin())
            && (!('moderationPaused' in existing()) || existing().moderationPaused != true || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessage', 'safetyAcceptedByBuyer', 'safetyAcceptedBySeller', 'updatedAt'
            ])
          )
          || (
            // One-way Protective Safety Pause Lock (participant or admin can flip -> paused; only admin can resume!)
            (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin())
            && 'moderationPaused' in incoming()
            && incoming().moderationPaused == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'moderationPaused', 'moderationPauseReason', 'moderationAlertId', 'updatedAt'
            ])
          )
          || (
            // Administrator-only conversation resume / moderation update
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessage', 'safetyAcceptedByBuyer', 'safetyAcceptedBySeller',
              'moderationPaused', 'moderationPauseReason', 'moderationAlertId', 'updatedAt'
            ])
          )
        );
      allow delete: if false;

      match /messages/{msgId} {
        function isConvParticipant() {
          let conv = get(/databases/$(database)/documents/conversations/$(convId)).data;
          return request.auth.uid == conv.buyerId || request.auth.uid == conv.sellerId || isAdmin();
        }
        allow get: if isSignedIn() && isValidId(convId) && isValidId(msgId) && isConvParticipant();
        allow list: if isSignedIn() && isValidId(convId) && isConvParticipant();
        allow create: if isSignedIn()
          && isValidId(convId)
          && isValidId(msgId)
          && isValidChatMessage(incoming())
          && incoming().senderId == request.auth.uid
          && (incoming().kind != 'system' || isAdmin())
          && incoming().createdAt == request.time
          && isConvParticipant()
          && (
            isAdmin()
            || (
              !isUserModerationSuspended(request.auth.uid)
              && !hasActiveRestrictionFlag(request.auth.uid, 'restrictPreDealChat')
              && (
                !('moderationPaused' in get(/databases/$(database)/documents/conversations/$(convId)).data)
                || get(/databases/$(database)/documents/conversations/$(convId)).data.moderationPaused != true
              )
            )
          )
          && (
            !('senderRole' in incoming())
            || (incoming().senderRole == 'buyer' && request.auth.uid == get(/databases/$(database)/documents/conversations/$(convId)).data.buyerId)
            || (incoming().senderRole == 'seller' && request.auth.uid == get(/databases/$(database)/documents/conversations/$(convId)).data.sellerId)
            || (incoming().senderRole in ['admin', 'system'] && isAdmin())
          );
        allow update, delete: if false;
      }
    }

    // 10. Private 3-Party Escrow Deals, Messages, Transfers, Reports & Events
    match /deals/{dealId} {
      allow get: if isSignedIn() && isValidId(dealId) && (
        resource == null
        || isAdmin()
        || existing().buyerId == request.auth.uid
        || existing().sellerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(dealId)
        && isValidDeal(incoming())
        && incoming().buyerId != incoming().sellerId
        && incoming().confirmedAtMs == 0
        && incoming().originalDeadlineMs == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            // Seller creating unpaid deal upon bid acceptance (atomically reserves listing & matches bid)
            incoming().sellerId == request.auth.uid
            && incoming().status in ['accepted_pending_payment', 'awaiting_payment']
            && 'acceptedBidId' in incoming()
            && isValidId(incoming().acceptedBidId)
            && exists(/databases/$(database)/documents/bids/$(incoming().acceptedBidId))
            && get(/databases/$(database)/documents/bids/$(incoming().acceptedBidId)).data.sellerId == request.auth.uid
            && get(/databases/$(database)/documents/bids/$(incoming().acceptedBidId)).data.buyerId == incoming().buyerId
            && get(/databases/$(database)/documents/bids/$(incoming().acceptedBidId)).data.listingId == incoming().listingId
            && incoming().baseAmountMinor == get(/databases/$(database)/documents/bids/$(incoming().acceptedBidId)).data.amountMinor
            && incoming().currency == get(/databases/$(database)/documents/bids/$(incoming().acceptedBidId)).data.currency
            && matchesConfiguredFees(incoming())
            && getAfter(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status == 'reserved'
            && getAfter(/databases/$(database)/documents/listings/$(incoming().listingId)).data.activeDealId == dealId
          )
          || (
            // Buyer creating funded deal upon atomic Buy Now payment (verifies listing price, fee, ledger & exact wallet debit)
            incoming().buyerId == request.auth.uid
            && !isUserModerationSuspended(request.auth.uid)
            && !hasActiveRestrictionFlag(request.auth.uid, 'restrictPurchasing')
            && incoming().status in ['paid_deal_room_active', 'awaiting_buyer_confirmation']
            && exists(/databases/$(database)/documents/listings/$(incoming().listingId))
            && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status == 'active'
            && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.sellerId == incoming().sellerId
            && incoming().baseAmountMinor == get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.priceMinor
            && incoming().currency == get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.currency
            && matchesConfiguredFees(incoming())
            && getAfter(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status == 'sold'
            && getAfter(/databases/$(database)/documents/listings/$(incoming().listingId)).data.activeDealId == dealId
            && !exists(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId))
            && existsAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId))
            && getAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId)).data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId)).data.kind == 'escrow_debit'
            && getAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId)).data.amountMinor == incoming().buyerTotalMinor
            && hasVerifiedBuyerWalletDebit(request.auth.uid, incoming().buyerTotalMinor, incoming().currency)
          )
        );
      allow update: if isSignedIn()
        && isValidId(dealId)
        && isValidDeal(incoming())
        // Fee snapshot & identities are strictly immutable after creation
        && incoming().listingId == existing().listingId
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && incoming().baseAmountMinor == existing().baseAmountMinor
        && incoming().buyerFeePct == existing().buyerFeePct
        && incoming().sellerFeePct == existing().sellerFeePct
        && incoming().buyerFeeMinor == existing().buyerFeeMinor
        && incoming().sellerFeeMinor == existing().sellerFeeMinor
        && incoming().buyerTotalMinor == existing().buyerTotalMinor
        && incoming().sellerPayoutMinor == existing().sellerPayoutMinor
        && incoming().platformCommissionMinor == existing().platformCommissionMinor
        && incoming().protectionDurationHours == existing().protectionDurationHours
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        // Terminal state lock unless admin correction (financial ledgers still enforce strict 1x idempotency)
        && (!(existing().status in ['settled', 'refunded', 'cancelled']) || isAdmin())
        // Immutable originalDeadlineMs rule: once set (>0), NEVER changes even by admin or report!
        && (existing().originalDeadlineMs == 0 || incoming().originalDeadlineMs == existing().originalDeadlineMs)
        && (
          (
            // Administrator dispute & settlement actions with deterministic ledger idempotency guards
            isAdmin()
            && (existing().originalDeadlineMs == 0 || incoming().confirmedAtMs == existing().confirmedAtMs)
            && (
              incoming().status != 'refunded'
              || (
                !(existing().status in ['accepted_pending_payment', 'awaiting_payment', 'refunded', 'settled'])
                && !exists(/databases/$(database)/documents/walletLedger/$('led_refund_' + dealId))
                && existsAfter(/databases/$(database)/documents/walletLedger/$('led_refund_' + dealId))
              )
            )
            && (
              incoming().status != 'settled'
              || (
                existing().status == 'settled'
                && incoming().diff(existing()).affectedKeys().hasOnly(['publicActivityId', 'updatedAt'])
              )
              || (
                !(existing().status in ['accepted_pending_payment', 'awaiting_payment', 'settled', 'refunded'])
                && !exists(/databases/$(database)/documents/walletLedger/$('led_release_' + dealId))
                && existsAfter(/databases/$(database)/documents/walletLedger/$('led_release_' + dealId))
              )
            )
          )
          || (
            // Buyer paying for accepted-bid deal atomically with deterministic payment ledger & verified wallet debit
            request.auth.uid == existing().buyerId
            && existing().status in ['accepted_pending_payment', 'awaiting_payment']
            && incoming().status in ['paid_deal_room_active', 'awaiting_buyer_confirmation']
            && getAfter(/databases/$(database)/documents/listings/$(existing().listingId)).data.status == 'sold'
            && getAfter(/databases/$(database)/documents/listings/$(existing().listingId)).data.activeDealId == dealId
            && !exists(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId))
            && existsAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId))
            && getAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId)).data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId)).data.kind == 'escrow_debit'
            && getAfter(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId)).data.amountMinor == existing().buyerTotalMinor
            && hasVerifiedBuyerWalletDebit(request.auth.uid, existing().buyerTotalMinor, existing().currency)
            && incoming().confirmedAtMs == 0
            && incoming().originalDeadlineMs == 0
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentLedgerId', 'paidAtMs', 'updatedAt'])
          )
          || (
            // Seller or buyer cancelling an UNPAID accepted-bid deal prior to payment
            (request.auth.uid == existing().sellerId || request.auth.uid == existing().buyerId)
            && existing().status in ['accepted_pending_payment', 'awaiting_payment']
            && incoming().status == 'cancelled'
            && !exists(/databases/$(database)/documents/walletLedger/$('led_pay_' + dealId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            // Seller submitting 2-3 transfer-proof screenshots to transfers/{submissionId}
            request.auth.uid == existing().sellerId
            && existing().status in [
              'paid_deal_room_active', 'paid', 'transfer_in_progress',
              'awaiting_buyer_confirmation', 'transfer_rejected'
            ]
            && incoming().status == 'transfer_submitted'
            && 'latestTransferSubmissionId' in incoming()
            && isValidId(incoming().latestTransferSubmissionId)
            && existsAfter(/databases/$(database)/documents/deals/$(dealId)/transfers/$(incoming().latestTransferSubmissionId))
            && incoming().confirmedAtMs == existing().confirmedAtMs
            && incoming().originalDeadlineMs == existing().originalDeadlineMs
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'transferSubmissionCount', 'latestTransferSubmissionId', 'latestRejectionReason', 'updatedAt'
            ])
          )
          || (
            // Buyer rejecting seller transfer proof with required written reason
            request.auth.uid == existing().buyerId
            && existing().status == 'transfer_submitted'
            && incoming().status == 'transfer_rejected'
            && 'latestRejectionReason' in incoming()
            && incoming().latestRejectionReason.size() >= 5
            && incoming().confirmedAtMs == existing().confirmedAtMs
            && incoming().originalDeadlineMs == existing().originalDeadlineMs
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'latestRejectionReason', 'updatedAt'])
          )
          || (
            // Buyer approving asset transfer ONCE to start immutable 168h (YouTube) or 40h (Standard) security timer
            request.auth.uid == existing().buyerId
            && existing().status in ['transfer_submitted', 'paid', 'transfer_in_progress', 'awaiting_buyer_confirmation']
            && existing().originalDeadlineMs == 0
            && incoming().status in ['security_period_active', 'protection_active']
            && incoming().confirmedAtMs >= request.time.toMillis() - 300000
            && incoming().confirmedAtMs <= request.time.toMillis() + 300000
            && incoming().originalDeadlineMs == incoming().confirmedAtMs + existing().protectionDurationHours * 3600000
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'confirmedAtMs', 'originalDeadlineMs', 'updatedAt'])
          )
          || (
            // Buyer or Seller filing a report pauses settlement WITHOUT modifying originalDeadlineMs
            (request.auth.uid == existing().buyerId || request.auth.uid == existing().sellerId)
            && existing().status in [
              'paid_deal_room_active', 'paid', 'transfer_in_progress',
              'transfer_submitted', 'awaiting_buyer_confirmation', 'transfer_rejected',
              'security_period_active', 'protection_active', 'reported_under_review'
            ]
            && incoming().status == 'reported_under_review'
            && incoming().confirmedAtMs == existing().confirmedAtMs
            && incoming().originalDeadlineMs == existing().originalDeadlineMs
            && incoming().unresolvedReportCount == existing().unresolvedReportCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'unresolvedReportCount', 'updatedAt'])
          )
          || (
            // One-way Protective Safety Pause Lock on Deal Room Chat (only isAdmin() can flip back to false)
            (request.auth.uid == existing().buyerId || request.auth.uid == existing().sellerId || isAdmin())
            && incoming().status == existing().status
            && incoming().confirmedAtMs == existing().confirmedAtMs
            && incoming().originalDeadlineMs == existing().originalDeadlineMs
            && 'moderationPaused' in incoming()
            && incoming().moderationPaused == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'moderationPaused', 'moderationPauseReason', 'moderationAlertId', 'updatedAt'
            ])
          )
        );
      allow delete: if false;

      match /messages/{msgId} {
        function isDealParticipant() {
          let d = get(/databases/$(database)/documents/deals/$(dealId)).data;
          return request.auth.uid == d.buyerId || request.auth.uid == d.sellerId || isAdmin();
        }
        allow get: if isSignedIn() && isValidId(dealId) && isValidId(msgId) && isDealParticipant();
        allow list: if isSignedIn() && isValidId(dealId) && isDealParticipant();
        allow create: if isSignedIn()
          && isValidId(dealId)
          && isValidId(msgId)
          && isValidChatMessage(incoming())
          && incoming().senderId == request.auth.uid
          && (incoming().kind != 'system' || isAdmin())
          && incoming().createdAt == request.time
          && isDealParticipant()
          && (
            isAdmin()
            || (
              !isUserModerationSuspended(request.auth.uid)
              && !hasActiveRestrictionFlag(request.auth.uid, 'restrictDealChat')
              && (
                !('moderationPaused' in get(/databases/$(database)/documents/deals/$(dealId)).data)
                || get(/databases/$(database)/documents/deals/$(dealId)).data.moderationPaused != true
              )
            )
          )
          && (
            !('senderRole' in incoming())
            || (incoming().senderRole == 'buyer' && request.auth.uid == get(/databases/$(database)/documents/deals/$(dealId)).data.buyerId)
            || (incoming().senderRole == 'seller' && request.auth.uid == get(/databases/$(database)/documents/deals/$(dealId)).data.sellerId)
            || (incoming().senderRole in ['admin', 'system'] && isAdmin())
          );
        allow update, delete: if false;
      }

      match /transfers/{submissionId} {
        function getParentDeal() {
          return get(/databases/$(database)/documents/deals/$(dealId)).data;
        }
        function isTransferDealViewer() {
          let d = getParentDeal();
          return request.auth.uid == d.buyerId || request.auth.uid == d.sellerId || isAdmin();
        }
        allow get: if isSignedIn() && isValidId(dealId) && isValidId(submissionId) && isTransferDealViewer();
        allow list: if isSignedIn() && isValidId(dealId) && isTransferDealViewer();
        allow create: if isSignedIn()
          && isValidId(dealId)
          && isValidId(submissionId)
          && isValidDealTransferSubmission(incoming(), dealId)
          && incoming().sellerId == request.auth.uid
          && incoming().status == 'submitted'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && getParentDeal().sellerId == request.auth.uid;
        allow update: if isSignedIn()
          && isValidId(dealId)
          && isValidId(submissionId)
          && isValidDealTransferSubmission(incoming(), dealId)
          && incoming().dealId == existing().dealId
          && incoming().sellerId == existing().sellerId
          && incoming().version == existing().version
          && incoming().screenshots == existing().screenshots
          && incoming().transferNote == existing().transferNote
          && incoming().completedSteps == existing().completedSteps
          && incoming().submittedAtMs == existing().submittedAtMs
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              existing().status == 'submitted'
              && incoming().status in ['approved', 'rejected']
              && incoming().buyerDecisionBy == request.auth.uid
              && getParentDeal().buyerId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'buyerDecisionBy', 'buyerDecisionReason', 'decidedAtMs', 'updatedAt'
              ])
            )
          );
        allow delete: if false;
      }

      match /reports/{reportId} {
        function isDealMember() {
          let d = get(/databases/$(database)/documents/deals/$(dealId)).data;
          return request.auth.uid == d.buyerId || request.auth.uid == d.sellerId || isAdmin();
        }
        allow get: if isSignedIn() && isValidId(dealId) && isValidId(reportId) && isDealMember();
        allow list: if isSignedIn() && isValidId(dealId) && isDealMember();
        allow create: if isSignedIn()
          && isValidId(dealId)
          && isValidId(reportId)
          && isValidDealReport(incoming(), dealId)
          && incoming().reporterId == request.auth.uid
          && incoming().status == 'open'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isDealMember()
          && (
            (incoming().reporterRole == 'buyer' && request.auth.uid == get(/databases/$(database)/documents/deals/$(dealId)).data.buyerId)
            || (incoming().reporterRole == 'seller' && request.auth.uid == get(/databases/$(database)/documents/deals/$(dealId)).data.sellerId)
          );
        allow update: if isAdmin()
          && isValidId(dealId)
          && isValidId(reportId)
          && isValidDealReport(incoming(), dealId)
          && incoming().dealId == existing().dealId
          && incoming().reporterId == existing().reporterId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'adminDecisionNote', 'decidedBy', 'decidedAtMs', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /events/{eventId} {
        function isEventDealParticipant() {
          let d = get(/databases/$(database)/documents/deals/$(dealId)).data;
          return request.auth.uid == d.buyerId || request.auth.uid == d.sellerId || isAdmin();
        }
        allow get: if isSignedIn() && isValidId(dealId) && isValidId(eventId) && isEventDealParticipant();
        allow list: if isSignedIn() && isValidId(dealId) && isEventDealParticipant();
        allow create: if isSignedIn()
          && isValidId(dealId)
          && isValidId(eventId)
          && isValidDealAuditEvent(incoming(), dealId)
          && incoming().actorId == request.auth.uid
          && incoming().createdAt == request.time
          && isEventDealParticipant()
          && (
            (incoming().actorRole == 'buyer' && request.auth.uid == get(/databases/$(database)/documents/deals/$(dealId)).data.buyerId)
            || (incoming().actorRole == 'seller' && request.auth.uid == get(/databases/$(database)/documents/deals/$(dealId)).data.sellerId)
            || (incoming().actorRole in ['admin', 'system'] && isAdmin())
          );
        allow update, delete: if false;
      }
    }

    // 11. Manual Deposit Requests
    match /deposits/{depositId} {
      allow get: if isSignedIn() && isValidId(depositId) && (
        isAdmin() || (resource != null && existing().userId == request.auth.uid)
      );
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(depositId)
        && isValidDepositRequest(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(depositId)
        && isValidDepositRequest(incoming())
        && existing().status == 'pending'
        && incoming().userId == existing().userId
        && incoming().amountMinor == existing().amountMinor
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'reviewedBy', 'updatedAt']);
      allow delete: if false;
    }

    // 12. Manual Withdrawal Requests
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && isValidId(withdrawalId) && (
        isAdmin() || (resource != null && existing().userId == request.auth.uid)
      );
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(withdrawalId)
        && isValidWithdrawalRequest(incoming())
        && incoming().userId == request.auth.uid
        && !isUserModerationSuspended(request.auth.uid)
        && !hasActiveRestrictionFlag(request.auth.uid, 'restrictWithdrawals')
        && !hasActiveRestrictionFlag(request.auth.uid, 'financialHoldActive')
        && incoming().status == 'pending'
        && incoming().currency == 'BDT'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/walletLedger/$('led_wd_' + withdrawalId))
        && existsAfter(/databases/$(database)/documents/walletLedger/$('led_wd_' + withdrawalId))
        && getAfter(/databases/$(database)/documents/walletLedger/$('led_wd_' + withdrawalId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/walletLedger/$('led_wd_' + withdrawalId)).data.kind == 'withdrawal_reserved'
        && getAfter(/databases/$(database)/documents/walletLedger/$('led_wd_' + withdrawalId)).data.amountMinor == incoming().amountMinor
        && getAfter(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data.walletBalanceMinor
           == get(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data.walletBalanceMinor - incoming().amountMinor
        && getAfter(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data.reservedBalanceMinor
           == get(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data.reservedBalanceMinor + incoming().amountMinor;
      allow update: if isAdmin()
        && isValidId(withdrawalId)
        && isValidWithdrawalRequest(incoming())
        && incoming().userId == existing().userId
        && incoming().amountMinor == existing().amountMinor
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'referenceId', 'rejectionReason', 'reviewedBy',
              'reviewedAtMs', 'publicActivityId', 'updatedAt'
            ])
          )
          || (
            existing().status == 'paid'
            && incoming().status == 'paid'
            && incoming().diff(existing()).affectedKeys().hasOnly(['publicActivityId', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // 13. Append-Only Financial Wallet Ledger
    match /walletLedger/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && (
        isAdmin() || (resource != null && existing().userId == request.auth.uid)
      );
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(entryId)
        && isValidWalletLedgerEntry(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (
            incoming().userId == request.auth.uid
            && incoming().kind == 'escrow_debit'
            && entryId == ('led_pay_' + incoming().referenceId)
            && existsAfter(/databases/$(database)/documents/deals/$(incoming().referenceId))
            && getAfter(/databases/$(database)/documents/deals/$(incoming().referenceId)).data.buyerId == request.auth.uid
          )
          || (
            incoming().userId == request.auth.uid
            && incoming().kind == 'withdrawal_reserved'
            && entryId == ('led_wd_' + incoming().referenceId)
            && existsAfter(/databases/$(database)/documents/withdrawals/$(incoming().referenceId))
            && getAfter(/databases/$(database)/documents/withdrawals/$(incoming().referenceId)).data.userId == request.auth.uid
          )
        );
      allow update, delete: if false;
    }

    // 14. Authentic Transaction-Verified Seller Reviews
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if resource.data.sellerId is string || (request.query.limit != null && request.query.limit <= 100);
      allow create: if isSignedIn()
        && isValidId(reviewId)
        && reviewId == ('rev_' + incoming().dealId)
        && isValidReview(incoming())
        && incoming().reviewerId == request.auth.uid
        && !isUserModerationSuspended(request.auth.uid)
        && !hasActiveRestrictionFlag(request.auth.uid, 'restrictReviews')
        && (!('moderationStatus' in incoming()) || incoming().moderationStatus == 'published')
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/deals/$(incoming().dealId))
        && get(/databases/$(database)/documents/deals/$(incoming().dealId)).data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/deals/$(incoming().dealId)).data.sellerId == incoming().sellerId
        && get(/databases/$(database)/documents/deals/$(incoming().dealId)).data.status == 'settled';
      allow update: if isAdmin()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().dealId == existing().dealId
        && incoming().sellerId == existing().sellerId
        && incoming().reviewerId == existing().reviewerId
        && incoming().score == existing().score
        && incoming().comment == existing().comment
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus']);
      allow delete: if false;
    }

    // 15. Public Platform Settings (Support contacts, fees, categories, branding)
    match /publicConfig/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(docId)
        && isValidPublicSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(docId)
        && isValidPublicSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'buyerFeeEnabled', 'buyerFeePct', 'sellerFeeEnabled', 'sellerFeePct',
          'usdToBdtRate', 'supportWhatsapp', 'supportTelegram', 'supportEmail',
          'bkashNumber', 'nagadNumber', 'rocketNumber', 'aiEmergencyStop',
          'disabledMonetizationIds', 'gamingTitles',
          'protectionHoursYoutube', 'protectionHoursFacebook', 'protectionHoursDefault',
          'customProtectionWindowsEnabled', 'fcmVapidPublicKey',
          'wordpressPaymentEnabled', 'wordpressSiteUrl', 'wordpressBridgeEndpoint',
          'siteName', 'brandTagline', 'logoUrl',
          'noticeBannerEnabled', 'noticeBannerText', 'enabledLanguages',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // 16. AI Developer Proposals (Admin-only, human-controlled approval)
    match /aiProposals/{proposalId} {
      allow get: if isAdmin() && isValidId(proposalId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(proposalId)
        && isValidAiProposal(incoming())
        && incoming().status in ['awaiting_review', 'in_review']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(proposalId)
        && isValidAiProposal(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'decidedBy', 'summary', 'proposedDiff', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 17. Append-Only Audit Logs
    match /auditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 18. User-Scoped Marketplace, Security, Escrow & Wallet Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (
        resource == null
        || existing().recipientId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && !('readAt' in incoming())
        && incoming().read == false
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('alertKind' in incoming()) || incoming().alertKind != 'admin_alert' || isAdmin())
        && (
          !('alertKind' in incoming())
          || incoming().alertKind != 'deal_room_created'
          || isAdmin()
          || (
            incoming().refType == 'deal'
            && isValidId(incoming().refId)
            && exists(/databases/$(database)/documents/deals/$(incoming().refId))
            && get(/databases/$(database)/documents/deals/$(incoming().refId)).data.status in [
              'paid_deal_room_active', 'paid', 'transfer_in_progress', 'transfer_submitted',
              'awaiting_buyer_confirmation', 'security_period_active', 'protection_active'
            ]
          )
        )
        && (
          isAdmin()
          || (
            // Self-scoped notification (registration welcome, verification, security, own listing/bid/deal/wallet events)
            incoming().recipientId == request.auth.uid
            && incoming().actorRole == 'user'
            && incoming().category in [
              'account', 'security', 'verification', 'listing',
              'bid', 'deal', 'dispute', 'wallet'
            ]
          )
          || (
            // Verified listing counterparty notification (buyer <-> seller on real listing)
            incoming().recipientId != request.auth.uid
            && incoming().actorRole == 'user'
            && incoming().category in ['bid', 'deal']
            && incoming().refType == 'listing'
            && isValidId(incoming().refId)
            && exists(/databases/$(database)/documents/listings/$(incoming().refId))
            && (
              get(/databases/$(database)/documents/listings/$(incoming().refId)).data.sellerId == incoming().recipientId
              || get(/databases/$(database)/documents/listings/$(incoming().refId)).data.sellerId == request.auth.uid
            )
          )
          || (
            // Verified escrow deal counterparty notification (buyer <-> seller on real deal)
            incoming().recipientId != request.auth.uid
            && incoming().actorRole == 'user'
            && incoming().category in ['deal', 'dispute']
            && incoming().refType == 'deal'
            && isValidId(incoming().refId)
            && exists(/databases/$(database)/documents/deals/$(incoming().refId))
            && (
              (
                get(/databases/$(database)/documents/deals/$(incoming().refId)).data.buyerId == request.auth.uid
                && get(/databases/$(database)/documents/deals/$(incoming().refId)).data.sellerId == incoming().recipientId
              )
              || (
                get(/databases/$(database)/documents/deals/$(incoming().refId)).data.sellerId == request.auth.uid
                && get(/databases/$(database)/documents/deals/$(incoming().refId)).data.buyerId == incoming().recipientId
              )
            )
          )
          || (
            // Verified pre-deal conversation counterparty notification (buyer <-> seller on real conversation)
            incoming().recipientId != request.auth.uid
            && incoming().actorRole == 'user'
            && incoming().category in ['deal', 'bid', 'listing']
            && incoming().refType == 'conversation'
            && isValidId(incoming().refId)
            && exists(/databases/$(database)/documents/conversations/$(incoming().refId))
            && (
              (
                get(/databases/$(database)/documents/conversations/$(incoming().refId)).data.buyerId == request.auth.uid
                && get(/databases/$(database)/documents/conversations/$(incoming().refId)).data.sellerId == incoming().recipientId
              )
              || (
                get(/databases/$(database)/documents/conversations/$(incoming().refId)).data.sellerId == request.auth.uid
                && get(/databases/$(database)/documents/conversations/$(incoming().refId)).data.buyerId == incoming().recipientId
              )
            )
          )
          || (
            // Verified deal participant alerting BEXORA Administration (report filed, transfer rejected, security timer elapsed)
            incoming().recipientId != request.auth.uid
            && incoming().actorRole == 'user'
            && incoming().category in ['deal', 'dispute']
            && incoming().refType == 'deal'
            && isValidId(incoming().refId)
            && exists(/databases/$(database)/documents/deals/$(incoming().refId))
            && (
              get(/databases/$(database)/documents/deals/$(incoming().refId)).data.buyerId == request.auth.uid
              || get(/databases/$(database)/documents/deals/$(incoming().refId)).data.sellerId == request.auth.uid
            )
            && (
              incoming().recipientId == 'FFiOzaXKxBMuCzoQXM68sy3aPax2'
              || exists(/databases/$(database)/documents/admins/$(incoming().recipientId))
            )
          )
        );
      allow update: if isSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && (
          isAdmin()
          || (
            existing().recipientId == request.auth.uid
            && incoming().recipientId == existing().recipientId
            && incoming().actorId == existing().actorId
            && incoming().createdAt == existing().createdAt
            && existing().read == false
            && incoming().read == true
            && incoming().readAt == request.time
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // 19. Admin-Managed Public Broadcast Announcements
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'preview', 'body', 'severity', 'destination', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // 20. Strictly Owner-Private Saved Marketplace Favorites
    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && isValidId(favoriteId) && (
        resource == null || existing().userId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(favoriteId)
        && isValidFavorite(incoming())
        && incoming().userId == request.auth.uid
        && favoriteId == ('fav_' + request.auth.uid + '_' + incoming().listingId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/listings/$(incoming().listingId))
        && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status in ['active', 'reserved', 'sold'];
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(favoriteId)
        && existing().userId == request.auth.uid;
    }

    // 21. Seller Follow Subscriptions (Atomically Paired with publicProfiles.followerCount)
    match /sellerFollows/{followId} {
      allow get: if isSignedIn() && isValidId(followId) && (
        resource == null
        || existing().followerId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.followerId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(followId)
        && isValidSellerFollow(incoming())
        && incoming().followerId == request.auth.uid
        && followId == ('fol_' + request.auth.uid + '_' + incoming().sellerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId))
        && getAfter(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId)).data.followerCount
           == (('followerCount' in get(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId)).data
             ? get(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId)).data.followerCount
             : 0) + 1);
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(followId)
        && existing().followerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/publicProfiles/$(existing().sellerId)).data.followerCount
           == (('followerCount' in get(/databases/$(database)/documents/publicProfiles/$(existing().sellerId)).data
             && get(/databases/$(database)/documents/publicProfiles/$(existing().sellerId)).data.followerCount > 0)
             ? get(/databases/$(database)/documents/publicProfiles/$(existing().sellerId)).data.followerCount - 1
             : 0);
    }

    // 22. Admin-Only Immutable AI Website Audit Reports
    match /aiAuditReports/{reportId} {
      allow get: if isAdmin() && isValidId(reportId);
      allow list: if isAdmin() && resource.data.reportId is string;
      allow create: if isAdmin()
        && isValidId(reportId)
        && isValidAiAuditReport(incoming(), reportId);
      allow update, delete: if false;
    }

    // 23. Admin-Only AI Assistant Conversations & Subcollection Messages
    match /aiConversations/{conversationId} {
      allow get: if isAdmin() && isValidId(conversationId);
      allow list: if isAdmin() && resource.data.createdBy is string;
      allow create: if isAdmin()
        && isValidId(conversationId)
        && isValidAiConversation(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(conversationId)
        && isValidAiConversation(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'summary', 'messageCount', 'lastMessagePreview',
          'pinnedReportId', 'updatedAtMs', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(conversationId);

      match /messages/{messageId} {
        allow get: if isAdmin()
          && isValidId(conversationId)
          && isValidId(messageId)
          && exists(/databases/$(database)/documents/aiConversations/$(conversationId));
        allow list: if isAdmin()
          && resource.data.conversationId == conversationId;
        allow create: if isAdmin()
          && isValidId(conversationId)
          && isValidId(messageId)
          && isValidAiConversationMessage(incoming(), conversationId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/aiConversations/$(conversationId));
        allow update, delete: if false;
      }
    }

    // 24. Admin-Only AI Daily Schedule Configuration
    match /aiSystemConfig/{configId} {
      allow get: if isAdmin() && configId == 'dailySchedule';
      allow list: if false;
      allow create: if isAdmin()
        && configId == 'dailySchedule'
        && isValidAiDailySchedule(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && configId == 'dailySchedule'
        && isValidAiDailySchedule(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'enabled', 'hour', 'minute', 'timezone',
          'notifyInApp', 'notifyTelegram', 'notifyEmail',
          'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 25. Sanitized PII-Free Public Activity Ticker Feed (Settled Deals & Paid Withdrawals Only)
    match /publicActivity/{activityId} {
      allow get: if isValidId(activityId);
      allow list: if resource.data.kind in ['sold', 'payout'] || (request.query.limit != null && request.query.limit <= 40);
      allow create: if isAdmin()
        && isValidId(activityId)
        && isValidPublicActivity(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(activityId)
        && isValidPublicActivity(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'actorDisplayName', 'actorVerified', 'assetTitle', 'platform',
          'amountMinor', 'currency', 'completedAtMs'
        ]);
      allow delete: if isAdmin() && isValidId(activityId);
    }

    // 26. Authenticated Review Abuse Reports (1 per user per review; Admin moderation)
    match /reviewReports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (
        resource == null
        || existing().reporterId == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin() && resource.data.reviewId is string;
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidId(reportId)
        && reportId == ('rrep_' + incoming().reviewId + '_' + request.auth.uid)
        && isValidReviewReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/reviews/$(incoming().reviewId));
      allow update: if isAdmin()
        && isValidId(reportId)
        && isValidReviewReport(incoming())
        && incoming().reviewId == existing().reviewId
        && incoming().dealId == existing().dealId
        && incoming().reporterId == existing().reporterId
        && incoming().reason == existing().reason
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // 27. Account Strike & Restriction Ledger (Owner/Admin read; strictly Admin-only write — prevents self-unban)
    match /userRestrictions/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId
        || isAdmin()
      );
      allow list: if isAdmin() && resource.data.userId is string;
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidUserRestriction(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(userId)
        && isValidUserRestriction(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'accountStatus', 'activeStrikes', 'totalHistoricalStrikes',
          'latestWarningTitle', 'latestWarningMessage', 'latestCategory',
          'restrictListings', 'restrictBidding', 'restrictPurchasing',
          'restrictPreDealChat', 'restrictDealChat', 'restrictReviews',
          'restrictProfileEdits', 'restrictWithdrawals', 'financialHoldActive',
          'requiresHumanPermanentBanReview', 'reason', 'enforcedBy', 'expiresAtMs',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // 28. User-to-User / Listing / Chat / Review Safety Reports (Reporter & Admin read only — hides reporter identity)
    match /userReports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (
        resource == null
        || existing().reporterId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidId(reportId)
        && isValidUserReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().reporterId != incoming().reportedUserId
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(reportId)
        && isValidUserReport(incoming())
        && incoming().reporterId == existing().reporterId
        && incoming().reportedUserId == existing().reportedUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'assignedAdminId', 'resolutionSummaryForReporter', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 29. Account Moderation Appeals (Appellant & Admin read; Admin-only decision updates)
    match /accountAppeals/{appealId} {
      allow get: if isSignedIn() && isValidId(appealId) && (
        resource == null
        || existing().userId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(appealId)
        && isValidAccountAppeal(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(appealId)
        && isValidAccountAppeal(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'adminDecisionNote', 'reviewedByAdminId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 30. Admin-Only 24/7 AI Security Monitor Live Alerts
    match /moderationAlerts/{alertId} {
      allow get: if isAdmin() && isValidId(alertId);
      allow list: if isAdmin() && resource.data.userId is string;
      allow create: if isAdmin()
        && isValidId(alertId)
        && isValidModerationAlert(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(alertId)
        && isValidModerationAlert(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'protectiveActionTaken', 'humanFinalDecision', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 31. Admin-Only Append-Only Immutable Moderation Audit Logs
    match /moderationAuditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin() && resource.data.targetUserId is string;
      allow create: if isAdmin()
        && isValidId(logId)
        && isValidModerationAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 32. SuperAdmin-Only Fraud/Security Identity Blocklist
    match /bannedIdentities/{banId} {
      allow get: if isSuperAdmin() && isValidId(banId);
      allow list: if isSuperAdmin() && resource.data.kind is string;
      allow create: if isSuperAdmin()
        && isValidId(banId)
        && isValidBannedIdentity(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSuperAdmin()
        && isValidId(banId)
        && isValidBannedIdentity(incoming())
        && incoming().identityHash == existing().identityHash
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['reason', 'enforcedBy']);
      allow delete: if isSuperAdmin() && isValidId(banId);
    }

    // 33. Live User Presence & Connection Monitoring (WhatsApp/Messenger-style real-time presence)
    match /userPresence/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.uid is string || (request.query.limit != null && request.query.limit <= 100);
      allow create: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserPresence(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserPresence(incoming(), userId)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['state', 'lastSeenMs', 'activeSessions', 'updatedAt']);
      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (request.auth.uid == userId || isAdmin());
        allow list: if isValidId(userId) && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(sessionId)
          && (request.auth.uid == userId || isAdmin())
          && isValidUserPresenceSession(incoming(), userId, sessionId)
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(sessionId)
          && (request.auth.uid == userId || isAdmin())
          && isValidUserPresenceSession(incoming(), userId, sessionId)
          && incoming().createdAtMs == existing().createdAtMs
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['state', 'lastHeartbeatAtMs', 'updatedAt']);
        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(sessionId)
          && (request.auth.uid == userId || isAdmin());
      }
    }

    // 34. Real-Time Active Status Presence (RTDB / Firestore Resilience)
    match /presence/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidPresenceNode(incoming());
      allow delete: if isAdmin();

      match /connections/{connectionId} {
        allow get, list: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}

