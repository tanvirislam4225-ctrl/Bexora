    }

    function isValidWalletLedgerEntry(data) {
      return data.keys().hasAll(['userId', 'kind', 'amountMinor', 'currency', 'referenceId', 'note', 'createdAt'])
        && data.keys().hasOnly(['userId', 'kind', 'amountMinor', 'currency', 'referenceId', 'note', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.kind in ['deposit_approved', 'escrow_debit', 'escrow_release', 'escrow_refund', 'withdrawal_reserved', 'withdrawal_paid', 'withdrawal_restored']
        && data.amountMinor is int && data.amountMinor > 0
        && data.currency in ['BDT', 'USD']
        && data.referenceId is string && data.referenceId.size() <= 128
        && data.note is string && data.note.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['dealId', 'sellerId', 'reviewerId', 'reviewerName', 'score', 'comment', 'createdAt'])
        && data.keys().hasOnly([
          'dealId', 'sellerId', 'sellerName', 'listingId', 'listingTitle', 'platform',
          'reviewerId', 'reviewerName', 'score', 'comment', 'moderationStatus', 'createdAt'
        ])
        && data.dealId is string && data.dealId.size() <= 128
        && data.sellerId is string && data.sellerId.size() <= 128
        && (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 80))
        && (!('listingId' in data) || isValidId(data.listingId))
        && (!('listingTitle' in data) || (data.listingTitle is string && data.listingTitle.size() <= 120))
        && (!('platform' in data) || data.platform in ['youtube', 'facebook', 'instagram', 'tiktok', 'telegram', 'website', 'domain', 'gaming'])
        && data.reviewerId is string && data.reviewerId.size() <= 128
        && data.reviewerId != data.sellerId
        && data.reviewerName is string && data.reviewerName.size() <= 80
        && data.score is int && data.score >= 1 && data.score <= 5
        && data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 600
        && (!('moderationStatus' in data) || data.moderationStatus in ['published', 'hidden'])
        && data.createdAt is timestamp;
    }

    function isValidPublicSettings(data) {
      return data.keys().hasAll([
          'buyerFeeEnabled', 'buyerFeePct', 'sellerFeeEnabled', 'sellerFeePct',
          'usdToBdtRate', 'supportWhatsapp', 'supportTelegram', 'supportEmail',
          'bkashNumber', 'nagadNumber', 'rocketNumber', 'aiEmergencyStop',
          'disabledMonetizationIds', 'gamingTitles',
          'protectionHoursYoutube', 'protectionHoursFacebook', 'protectionHoursDefault',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'buyerFeeEnabled', 'buyerFeePct', 'sellerFeeEnabled', 'sellerFeePct',
          'usdToBdtRate', 'supportWhatsapp', 'supportTelegram', 'supportEmail',
          'bkashNumber', 'nagadNumber', 'rocketNumber', 'aiEmergencyStop',
          'disabledMonetizationIds', 'gamingTitles',
          'protectionHoursYoutube', 'protectionHoursFacebook', 'protectionHoursDefault',
          'customProtectionWindowsEnabled', 'fcmVapidPublicKey',
          'wordpressPaymentEnabled', 'wordpressSiteUrl', 'wordpressBridgeEndpoint',
          'siteName', 'brandTagline', 'logoUrl',
          'noticeBannerEnabled', 'noticeBannerText', 'enabledLanguages',
          'updatedAt'
        ])
        && data.buyerFeeEnabled is bool
        && data.buyerFeePct is number && data.buyerFeePct >= 0 && data.buyerFeePct <= 50
        && data.sellerFeeEnabled is bool
        && data.sellerFeePct is number && data.sellerFeePct >= 0 && data.sellerFeePct <= 50
        && data.usdToBdtRate is number && data.usdToBdtRate > 0 && data.usdToBdtRate <= 500
        && data.supportWhatsapp is string && data.supportWhatsapp.size() <= 32
        && data.supportTelegram is string && data.supportTelegram.size() <= 160
        && data.supportEmail is string && data.supportEmail.size() <= 160
        && data.bkashNumber is string && data.bkashNumber.size() <= 32
        && data.nagadNumber is string && data.nagadNumber.size() <= 32
        && data.rocketNumber is string && data.rocketNumber.size() <= 32
        && data.aiEmergencyStop is bool
        && data.disabledMonetizationIds is list && data.disabledMonetizationIds.size() <= 50 && (data.disabledMonetizationIds.size() == 0 || (data.disabledMonetizationIds[0] is string && data.disabledMonetizationIds[0].size() <= 64))
        && data.gamingTitles is list && data.gamingTitles.size() <= 20 && (data.gamingTitles.size() == 0 || (data.gamingTitles[0] is string && data.gamingTitles[0].size() <= 64))
        && data.protectionHoursYoutube is int && data.protectionHoursYoutube >= 1 && data.protectionHoursYoutube <= 720
        && data.protectionHoursFacebook is int && data.protectionHoursFacebook >= 1 && data.protectionHoursFacebook <= 720
        && data.protectionHoursDefault is int && data.protectionHoursDefault >= 1 && data.protectionHoursDefault <= 720
        && (!('customProtectionWindowsEnabled' in data) || data.customProtectionWindowsEnabled is bool)
        && (!('fcmVapidPublicKey' in data) || (data.fcmVapidPublicKey is string && data.fcmVapidPublicKey.size() <= 100 && data.fcmVapidPublicKey.matches('^$|^[A-Za-z0-9_\\-]{84,92}$')))
        && (!('wordpressPaymentEnabled' in data) || data.wordpressPaymentEnabled is bool)
        && (!('wordpressSiteUrl' in data) || (data.wordpressSiteUrl is string && data.wordpressSiteUrl.size() <= 200 && data.wordpressSiteUrl.matches('^$|^https://[A-Za-z0-9.\\-/:_]+$')))
        && (!('wordpressBridgeEndpoint' in data) || (data.wordpressBridgeEndpoint is string && data.wordpressBridgeEndpoint.size() <= 100 && data.wordpressBridgeEndpoint.matches('^/[A-Za-z0-9_/\\-]+$')))
        && (!('siteName' in data) || (data.siteName is string && data.siteName.size() <= 60))
        && (!('brandTagline' in data) || (data.brandTagline is string && data.brandTagline.size() <= 140))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 300 && data.logoUrl.matches('^$|^\\./icon\\.svg$|^https://[A-Za-z0-9.\\-/:_?=&%]+$')))
        && (!('noticeBannerEnabled' in data) || data.noticeBannerEnabled is bool)
        && (!('noticeBannerText' in data) || (data.noticeBannerText is string && data.noticeBannerText.size() <= 280))
        && (!('enabledLanguages' in data) || (data.enabledLanguages is list && data.enabledLanguages.size() >= 1 && data.enabledLanguages.size() <= 5 && data.enabledLanguages.hasOnly(['en', 'bn', 'hi', 'ar', 'ur'])))
        && data.updatedAt is timestamp;
    }

    function isValidAiProposal(data) {
      return data.keys().hasAll([
          'title', 'category', 'severity', 'summary',
          'affectedFiles', 'proposedDiff', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'category', 'severity', 'summary',
          'affectedFiles', 'proposedDiff', 'status', 'decidedBy', 'linkedIssueId', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.category in ['bugfix', 'security', 'feature', 'performance']
        && data.severity in ['low', 'medium', 'high', 'critical']
        && data.summary is string && data.summary.size() <= 2000
        && data.affectedFiles is list && data.affectedFiles.size() <= 20 && (data.affectedFiles.size() == 0 || (data.affectedFiles[0] is string && data.affectedFiles[0].size() <= 160))
        && data.proposedDiff is string && data.proposedDiff.size() <= 8000
        && data.status in ['awaiting_review', 'in_review', 'approved', 'rejected', 'deployed']
        && (!('decidedBy' in data) || (data.decidedBy is string && data.decidedBy.size() <= 128))
        && (!('linkedIssueId' in data) || (data.linkedIssueId is string && data.linkedIssueId.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorId', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.keys().hasOnly(['actorId', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.actorId is string && data.actorId.size() <= 128
        && data.action is string && data.action.size() <= 80
        && data.targetType is string && data.targetType.size() <= 40
        && data.targetId is string && data.targetId.size() <= 128
        && data.details is string && data.details.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidPushToken(data, uid) {
      return data.keys().hasAll(['uid', 'token', 'userAgent', 'enabled', 'createdAtMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'token', 'userAgent', 'platform', 'deviceLabel',
          'enabled', 'createdAtMs', 'lastRefreshedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.token is string && data.token.size() >= 20 && data.token.size() <= 1024
        && data.userAgent is string && data.userAgent.size() <= 240
        && (!('platform' in data) || data.platform in ['web', 'ios_pwa'])
        && (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 80))
        && data.enabled is bool
        && data.createdAtMs is int && data.createdAtMs >= 0
        && (!('lastRefreshedAtMs' in data) || (data.lastRefreshedAtMs is int && data.lastRefreshedAtMs >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'recipientId', 'actorId', 'actorRole', 'category', 'severity',
          'title', 'preview', 'body', 'refType', 'refId',
          'referenceLabel', 'destination', 'read', 'createdAtMs',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'recipientId', 'actorId', 'actorRole', 'category', 'severity', 'alertKind',
          'title', 'preview', 'body', 'refType', 'refId',
          'referenceLabel', 'destination', 'read', 'readAt', 'createdAtMs',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.recipientId)
        && isValidId(data.actorId)
        && data.actorRole in ['user', 'admin', 'system']
        && data.category in [
          'account', 'security', 'verification', 'listing', 'bid',
          'deal', 'dispute', 'wallet', 'announcement', 'system'
        ]
        && data.severity in ['info', 'success', 'warning', 'critical']
        && (!('alertKind' in data) || data.alertKind in ['normal', 'deal_room_created', 'admin_alert'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.preview is string && data.preview.size() >= 1 && data.preview.size() <= 240
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.refType in ['none', 'listing', 'deal', 'wallet', 'profile', 'announcement', 'conversation']
        && data.refId is string && data.refId.size() <= 128
        && data.referenceLabel is string && data.referenceLabel.size() <= 140
        && data.destination is string && data.destination.size() <= 160
        && data.read is bool
