# GEMINI_API_KEY: Server-side only API key for AI monetization screenshot review & AI Developer chat.
# Automatically injected in AI Studio from user secrets. Never exposed to browser bundles.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application (injected automatically on Cloud Run).
APP_URL="https://your-bexora-domain.example.com"

# Manual Payment Destination Numbers (Optional server-side defaults; can also be managed live in Admin Panel -> Payment & Fee Settings)
# Leave blank if a manual payment channel should remain disabled until configured.
BKASH_PAYMENT_NUMBER=""
NAGAD_PAYMENT_NUMBER=""
ROCKET_PAYMENT_NUMBER=""

# Optional Fixed Superadmin Phone Identifier (Normalized E.164 format, e.g. +8801XXXXXXXXX)
# Never place passwords in .env.example or frontend variables.
BEXORA_SUPERADMIN_PHONE=""

# Firebase Cloud Messaging Web Push Public Certificate Key (VAPID public key ONLY — ~87-char base64url P-256 public key; NEVER place private keys here).
# Project: responsive-dragon-tmn89 (448578956301) | Web App: 1:448578956301:web:091629c6e19eafa50ef944
# Generate or copy in Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY=""

# Optional Server-Only Firebase Admin Service Account JSON (for external Node hosts outside Google Cloud ADC; NEVER prefix with VITE_).
FIREBASE_SERVICE_ACCOUNT_JSON=""

