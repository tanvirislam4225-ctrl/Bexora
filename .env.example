# GEMINI_API_KEY: Server-side only API key for AI monetization screenshot review & AI Developer chat.
GEMINI_API_KEY=""

# APP_URL: Hosted URL of the application on Render or custom domain (e.g. https://bexora.onrender.com)
APP_URL=""

# Manual Payment Destination Numbers (Optional server-side defaults; can also be managed live in Admin Panel -> Payment & Fee Settings)
# Leave blank if a manual payment channel should remain disabled until configured.
BKASH_PAYMENT_NUMBER=""
NAGAD_PAYMENT_NUMBER=""
ROCKET_PAYMENT_NUMBER=""

# Optional Fixed Superadmin Phone Identifier (Normalized E.164 format, e.g. +8801XXXXXXXXX)
# Never place passwords in .env.example or frontend variables.
BEXORA_SUPERADMIN_PHONE=""

# Firebase Admin SDK & Web Push Configuration (Auto-configured — optional overrides only):
# - Server-side Firebase Admin SDK automatically uses Google Cloud Run Managed Application Default Credentials (applicationDefault()), or optional FIREBASE_SERVICE_ACCOUNT_JSON on external hosts.
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# - Browser Web Push automatically uses FCM's official managed default Web Push public key, or an optional custom 87-88 char base64url P-256 public key (never place private VAPID keys in VITE_*).
# VITE_FIREBASE_VAPID_KEY=""
# - Optional custom verified HTTPS authDomain override (must serve /__/auth/handler and be registered in both Firebase Authorized Domains and Google OAuth redirect URIs).
# VITE_FIREBASE_CUSTOM_AUTH_DOMAIN=""

# Secure Pay BD Live Payment Gateway (Server-side only — NEVER expose to VITE_ or frontend code):
# Supports direct mobile banking & cards: bKash, Nagad, Rocket, Upay, Visa, Mastercard
SECUREPAY_API_KEY=""
# Optional custom gateway site URL (defaults to https://pay.securepaybd.xyz/)
# SECUREPAY_SITE_URL="https://pay.securepaybd.xyz/"

# Optional WordPress Live Payment Bridge Secrets (Server-side only — NEVER expose to VITE_ or publicConfig):
# Until configured and verified reachable, BEXORA Wallet Balance remains active while unconfigured live gateways stay safely locked.
# WORDPRESS_SITE_URL=""
# WORDPRESS_WEBHOOK_SECRET=""
# WORDPRESS_CONSUMER_KEY=""
# WORDPRESS_CONSUMER_SECRET=""

# Optional Server-Side Daily AI Audit Notification Channels (Server-side only — never exposed to client):
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_ADMIN_CHAT_ID=""
# ADMIN_ALERT_WEBHOOK_URL=""



