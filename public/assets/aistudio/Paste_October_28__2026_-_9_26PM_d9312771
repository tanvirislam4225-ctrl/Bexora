}
@media(min-width:768px){.support-panel{bottom:88px;right:24px}}
.support-link{display:flex;align-items:center;gap:10px;padding:12px 14px;font-size:13.5px;font-weight:700;
border-bottom:1px solid var(--border-soft);transition:background .15s}
.support-link:last-child{border-bottom:0}
.support-link:hover{background:var(--surface-2)}
.support-link.disabled{opacity:.45;pointer-events:none}
/* Admin */
.admin-grid{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:960px){.admin-grid{grid-template-columns:230px minmax(0,1fr);gap:20px}}
.admin-nav{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;scrollbar-width:thin}
@media(min-width:960px){.admin-nav{flex-direction:column;overflow:visible;position:sticky;top:80px;align-self:start}}
.admin-nav button{
display:flex;align-items:center;gap:9px;padding:10px 13px;border-radius:10px;font-size:13px;font-weight:700;
color:var(--text-2);white-space:nowrap;border:1.5px solid transparent;transition:all .15s;flex:none;
}
.admin-nav button:hover{background:var(--surface-2);color:var(--text)}
.admin-nav button.on{background:var(--surface);border-color:var(--border-strong);color:var(--text);box-shadow:var(--shadow-sm)}
@media(min-width:960px){.admin-nav button{width:100%}}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:var(--r);border:1px solid var(--border-soft)}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:520px}
th{text-align:left;padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.06em;
color:var(--text-2);background:var(--surface-2);border-bottom:1px solid var(--border-soft);white-space:nowrap}
td{padding:11px 12px;border-bottom:1px solid var(--border-soft);vertical-align:middle}
tr:last-child td{border-bottom:0}
/* Deal room */
.chat{display:flex;flex-direction:column;gap:9px;max-height:300px;overflow-y:auto;padding:4px}
.bubble{max-width:82%;padding:9px 13px;border-radius:14px;font-size:13px;line-height:1.45;background:var(--surface-2);
border:1px solid var(--border-soft);align-self:flex-start;word-break:break-word}
.bubble.me{align-self:flex-end;background:var(--orange);color:#fff;border-color:transparent}
