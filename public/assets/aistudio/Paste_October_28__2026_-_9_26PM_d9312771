                  <div style={{minWidth:0}}>
                    <div className="row" style={{gap:5}}>
                      <b className="sm" style={{overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{s.name}</b>
                      {s.verified && <Icon name="shield" size={13} style={{color:'var(--green)',flex:'none'}}/>}
                    </div>
                    <p className="hint">★ {s.rating} · {s.completed} trades</p>
                  </div>
                </div>
                <div className="row-between" style={{marginTop:10}}>
                  <span className="chip chip-purple">#{i+1}</span>
                  <span className="hint">Since {s.joined}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    )}

    {/* MARKETPLACE */}
    {page==='market' && (
      <div className="wrap page">
        <div className="row-between" style={{marginBottom:16}}>
          <div>
            <p className="eyebrow">Marketplace</p>
            <h2>{applied.platform==='all'?'All digital assets':PLATFORM_META[applied.platform].name+' assets'}</h2>
          </div>
          <div className="row" style={{gap:8}}>
            <div className="search-box" style={{width:'auto',minWidth:0}}>
              <Icon name="search" size={15} style={{color:'var(--text-3)'}}/>
              <input placeholder="Search…" value={search} onChange={e=>setSearch(e.target.value)}
                style={{width:130}} aria-label="Search listings"/>
            </div>
            <button className="btn show-mobile" onClick={()=>setFilterOpen(true)}
              style={{display:'inline-flex'}}>
              <Icon name="filter" size={15}/> Filters
            </button>
          </div>
        </div>

        <div style={{display:'grid',gap:20,gridTemplateColumns:'1fr'}} className="market-layout">
          <aside className="hide-mobile" style={{width:270,flex:'none'}}>
            <div className="card card-pad" style={{position:'sticky',top:80}}>
              <FilterPanel draft={draft} setDraft={setDraft}
                onApply={()=>setApplied(draft)}
                onReset={()=>{setDraft(emptyFilters);setApplied(emptyFilters);}}
                count={filtered.length}/>
            </div>
          </aside>

          <div style={{minWidth:0}}>
            {activeChips.length>0 && (
              <div className="row" style={{gap:6,flexWrap:'wrap',marginBottom:12}}>
                {activeChips.map(([k,label])=>(
                  <button key={k} className="chip chip-on" onClick={()=>removeChip(k)}>
                    {label} <Icon name="x" size={11}/>
                  </button>
                ))}
                <button className="chip" onClick={()=>{setDraft(emptyFilters);setApplied(emptyFilters);}}>
                  Clear all
                </button>
              </div>
            )}
            <p className="hint" style={{marginBottom:12}}>
              {filtered.length} listing{filtered.length===1?'':'s'} found
              {applied.methods.length>1 && ' · matching any selected program'}
            </p>

            {filtered.length===0 ? (
              <div className="empty card card-pad">
                <div className="eico"><Icon name="search" size={22}/></div>
                <h3>No listings match your filters</h3>
                <p className="sm">Try widening the price range or removing a monetization filter.</p>
                <button className="btn btn-sm" onClick={()=>{setDraft(emptyFilters);setApplied(emptyFilters);}}>Reset filters</button>
              </div>
            ) : (
              <div className="listings">
                {filtered.map(l=><ListingCard key={l.id} l={l} onOpen={openListing}/>)}
              </div>
            )}
          </div>
        </div>
      </div>
    )}

    {/* TOP SELLERS */}
    {page==='sellers' && (
      <div className="wrap page">
        <p className="eyebrow">Reputation</p>
        <h2 style={{marginBottom:4}}>Top sellers</h2>
        <p className="hint" style={{marginBottom:18}}>Ranked by completed sales, buyer rating and successful trade rate.</p>
        <div className="stack" style={{gap:10}}>
          {topSellers.map((s,i)=>(
            <div key={s.id} className="card card-pad">
              <div className="row" style={{gap:12}}>
                <span style={{fontWeight:800,fontSize:18,color:'var(--orange)',width:28,flex:'none'}}>#{i+1}</span>
                <div className="avatar" style={{width:44,height:44,fontSize:15,background:s.avatar}}>{initials(s.name)}</div>
                <div style={{flex:1,minWidth:0}}>
                  <div className="row" style={{gap:6,flexWrap:'wrap'}}>
                    <b>{s.name}</b>
                    {s.verified && <span className="badge chip-verified">Verified</span>}
                    {s.badges.includes('trader') && <span className="badge chip-purple">Completed Trader</span>}
                  </div>
                  <p className="hint">@{s.username} · Member since {s.joined}</p>
                </div>
                <div style={{textAlign:'right',flex:'none'}}>
                  <b style={{display:'block'}}>★ {s.rating}</b>
                  <span className="hint">{s.completed} trades</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* EARN */}
    {page==='earn' && (
      <div className="wrap page">
        <p className="eyebrow">Rewards</p>
        <h2 style={{marginBottom:4}}>Earn with BEXORA</h2>
        <p className="hint" style={{marginBottom:18}}>
          Rewards are credited only after a verified partner postback. A countdown alone is never treated as proof of completion.
        </p>
        <div className="stack" style={{gap:10}}>
          {earnings.map(t=>(
            <div key={t.id} className="card card-pad">
              <div className="row-between" style={{marginBottom:6}}>
                <b className="sm">{t.title}</b>
                <span className="chip chip-verified">+{money(t.reward)}</span>
              </div>
              <p className="hint" style={{marginBottom:10}}>{t.desc}</p>
              <div className="row" style={{gap:8}}>
                <button className="btn btn-sm btn-yellow" onClick={()=>flash('Task opened. Rewards credit after partner verification.')}>
                  Start task
                </button>
                <span className="badge chip-claimed">
                  {t.status==='verification-required'?'Awaiting partner verification':'Verification pending'}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* DEALS */}
    {page==='deals' && (
      <div className="wrap page">
        <div className="row-between" style={{marginBottom:16}}>
          <div>
            <p className="eyebrow">Escrow</p>
            <h2>Your deals</h2>
          </div>
          <span className="chip">{deals.length} active</span>
        </div>
        {deals.length===0 ? (
          <div className="empty card card-pad">
            <div className="eico"><Icon name="chat" size={22}/></div>
            <h3>No deals yet</h3>
            <p className="sm">Purchases and accepted bids appear here with their protection timer.</p>
            <button className="btn btn-sm" onClick={()=>setPage('market')}>Browse marketplace</button>
          </div>
        ) : (
          <div className="stack" style={{gap:12}}>
            {deals.map(d=>{
              const deadline = d.confirmedAt + d.durationHours*H;
              return (
                <div key={d.id} className="card card-pad" style={{cursor:'pointer'}}
                  onClick={()=>setModal({type:'deal',data:d})}
                  role="button" tabIndex={0}
                  onKeyDown={e=>{if(e.key==='Enter')setModal({type:'deal',data:d});}}>
                  <div className="row-between" style={{marginBottom:10}}>
                    <div style={{minWidth:0}}>
                      <b className="sm" style={{display:'block',overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{d.title}</b>
                      <p className="hint">Deal #{d.id} · {money(d.amount)}</p>
                    </div>
                    <span className={'badge '+(d.status==='protection'?'chip-verified':d.status==='under-review'?'chip-claimed':'chip-red')}>
                      {d.status.replace('-',' ')}
                    </span>
                  </div>
                  <Countdown deadline={deadline}/>
                  <p className="hint" style={{marginTop:8}}>
                    {d.status==='under-review'
                      ? 'Under admin review — the deadline is fixed and will not be extended.'
                      : d.status==='refunded' ? 'Buyer refunded. Deal closed.'
                      : 'Funds release to the seller only after the protection period ends without a dispute.'}
                  </p>
                </div>
              );
            })}
          </div>
        )}
      </div>
    )}

    {/* PROFILE */}
    {page==='profile' && (
      <div className="wrap page">
        {!user ? (
          <div className="empty card card-pad">
            <div className="eico"><Icon name="user" size={22}/></div>
            <h3>You are not signed in</h3>
            <p className="sm">Sign in to view your wallet, purchases and deals.</p>
            <button className="btn btn-primary btn-sm" onClick={()=>setModal({type:'auth'})}>Sign in</button>
          </div>
        ) : (
          <div className="stack" style={{gap:16}}>
            <div className="card card-pad">
              <div className="row" style={{gap:12}}>
                <div className="avatar" style={{width:52,height:52,fontSize:18,background:'var(--orange)'}}>{initials(user.name)}</div>
                <div style={{flex:1,minWidth:0}}>
                  <div className="row" style={{gap:6,flexWrap:'wrap'}}>
                    <b>{user.name}</b>
                    {user.role==='admin' && <span className="badge chip-purple">Administrator</span>}
                  </div>
                  <p className="hint">{user.email}</p>
                </div>
                <button className="btn btn-sm" onClick={()=>{setUser(null);setPage('home');flash('Signed out.');}}>
                  <Icon name="logout" size={14}/> Sign out
                </button>
              </div>
            </div>

            <div className="card card-pad" style={{background:'var(--orange)',color:'#fff',borderColor:'var(--border-strong)'}}>
              <p className="tiny" style={{opacity:.85,fontWeight:800,letterSpacing:'.1em'}}>WALLET BALANCE</p>
              <p style={{fontSize:'clamp(26px,7vw,36px)',fontWeight:800,letterSpacing:'-.03em',marginTop:2}}>{money(wallet.balance)}</p>
              <div className="row" style={{gap:8,marginTop:12}}>
                <button className="btn btn-yellow btn-sm" onClick={()=>setModal({type:'wallet'})}>Add balance</button>
                <button className="btn btn-sm" style={{background:'rgba(255,255,255,.16)',color:'#fff',borderColor:'rgba(255,255,255,.4)',boxShadow:'none'}}
                  onClick={()=>setPage('deals')}>View deals</button>
              </div>
            </div>

            {user.role==='admin' && (
              <button className="btn btn-purple btn-block" onClick={()=>setPage('admin')}>
                <Icon name="settings" size={16}/> Open admin dashboard
              </button>
            )}

            <div className="card card-pad">
              <h3 style={{marginBottom:10}}>Purchase history</h3>
              {wallet.purchases.length===0
                ? <p className="hint">No purchases yet.</p>
                : wallet.purchases.map(p=>(
                    <div key={p.id} className="row-between soft" style={{marginBottom:6}}>
                      <div style={{minWidth:0}}>
                        <b className="sm" style={{display:'block',overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{p.title}</b>
                        <p className="hint">{new Date(p.at).toLocaleString()}</p>
                      </div>
                      <b className="sm">{money(p.amount)}</b>
                    </div>
                  ))}
            </div>

            <div className="card card-pad">
              <h3 style={{marginBottom:10}}>Deposit history</h3>
              {wallet.deposits.length===0
                ? <p className="hint">No deposit requests yet.</p>
                : wallet.deposits.map(d=>(
                    <div key={d.id} className="row-between soft" style={{marginBottom:6}}>
                      <div>
                        <b className="sm">{money(d.amount)}</b>
                        <p className="hint">{d.method.toUpperCase()} · {d.txid}</p>
                      </div>
                      <span className={'badge '+(d.status==='approved'?'chip-verified':d.status==='pending'?'chip-claimed':'chip-red')}>{d.status}</span>
                    </div>
                  ))}
            </div>
          </div>
        )}
      </div>
    )}

    {/* ADMIN */}
    {page==='admin' && (
      user?.role==='admin'
        ? <AdminDashboard
            listings={listings}
            onApprove={id=>setListings(ls=>ls.map(l=>l.id===id?{...l,status:'active'}:l))}
            onReject={id=>setListings(ls=>ls.map(l=>l.id===id?{...l,status:'rejected'}:l))}
            wallet={wallet} onDepositDecision={decideDeposit}
            deals={deals} onResume={resumeDeal} onRejectDeal={rejectDeal}
            settings={settings} onSaveSettings={s=>{setSettings(s);setMonetizationConfig(c=>({...c}));}}
            monetizationConfig={monetizationConfig}
            onToggleMonetization={id=>setMonetizationConfig(c=>({...c,[id]:!(c[id]!==false)}))}
            user={user}/>
        : <div className="wrap page">
            <div className="empty card card-pad">
              <div className="eico"><Icon name="shield" size={22}/></div>
              <h3>Administrator access required</h3>
              <p className="sm">Your account does not have administrator permissions.</p>
              <button className="btn btn-primary btn-sm" onClick={()=>setModal({type:'auth'})}>Sign in as admin</button>
            </div>
          </div>
    )}
  </main>

  {/* FLOATING CREATE BUTTON (desktop) */}
  <button className="hide-mobile" onClick={()=>setModal({type:'create'})}
    style={{position:'fixed',right:24,bottom:96,zIndex:70}} aria-label="Create listing">
    <span className="btn btn-yellow" style={{borderRadius:999,height:52,padding:'0 20px'}}>
      <Icon name="plus" size={18}/> Sell an asset
    </span>
  </button>

  {/* SUPPORT WIDGET */}
  <button className="support-fab" onClick={()=>setSupportOpen(o=>!o)} aria-label="Support">
    <Icon name={supportOpen?'x':'support'} size={22}/>
  </button>
  {supportOpen && (
    <div className="support-panel" role="dialog" aria-label="Support options">
      <div style={{padding:'12px 14px',borderBottom:'2px solid var(--border-soft)'}}>
        <b className="sm">Need help?</b>
        <p className="hint">Reach the BEXORA support team.</p>
      </div>
      {settings.support.whatsapp ? (
        <a className="support-link" href={'https://wa.me/'+settings.support.whatsapp} target="_blank" rel="noopener noreferrer">
          <Icon name="chat" size={17} style={{color:'var(--green)'}}/> WhatsApp
        </a>
      ) : <div className="support-link disabled"><Icon name="chat" size={17}/> WhatsApp — not configured</div>}

      {settings.support.telegram ? (
        <a className="support-link" href={settings.support.telegram} target="_blank" rel="noopener noreferrer">
          <Icon name="send" size={17} style={{color:'var(--purple)'}}/> Telegram
        </a>
      ) : <div className="support-link disabled"><Icon name="send" size={17}/> Telegram — not configured</div>}

      {settings.support.email ? (
        <a className="support-link" href={'mailto:'+settings.support.email}>
          <Icon name="file" size={17} style={{color:'var(--orange)'}}/> Email support
        </a>
      ) : <div className="support-link disabled"><Icon name="file" size={17}/> Email — not configured</div>}
    </div>
  )}

  {/* BOTTOM NAV */}
  <nav className="bottomnav" aria-label="Mobile navigation">
    {[['home','Home','home'],['sellers','Sellers','users'],['earn','Earn','gift'],['deals','Deals','chat'],['profile','Profile','user']].map(([id,label,icon])=>(
      <button key={id} className={'bn-item'+(page===id?' on':'')} onClick={()=>setPage(id)}>
        <Icon name={icon} size={20}/>
        <span>{label}</span>
        <span className="bn-dot"/>
      </button>
    ))}
  </nav>

  {/* MODALS */}
  {modal?.type==='auth' && <AuthModal onClose={()=>setModal(null)} onLogin={u=>{
    setUser(u); setModal(null);
    flash('Signed in as '+u.name);
    if(u.role==='admin') setPage('admin');
  }}/>}

  {modal?.type==='create' && <CreateListingModal
    onClose={()=>setModal(null)}
    user={user}
    onRequireAuth={()=>{setModal({type:'auth'});flash('Sign in to publish a listing.');}}
    onSubmit={l=>{
      setListings(ls=>[l,...ls]);
      setModal(null);
      flash('Listing submitted for administrator review.');
      setPage('profile');
    }}/>}

  {modal?.type==='listing' && <ListingDetailModal
    l={listings.find(x=>x.id===modal.data.id)||modal.data}
    onClose={()=>setModal(null)}
    user={user}
    onRequireAuth={()=>{setModal({type:'auth'});flash('Sign in to continue.');}}
    onBuy={buyNow}
    onBid={placeBid}
    onMessage={messageSeller}
    buyerFeePct={settings.buyerFeePct}/>}

  {modal?.type==='wallet' && <WalletModal
    onClose={()=>setModal(null)}
    wallet={wallet}
    settings={settings}
    onSubmitDeposit={submitDeposit}/>}

  {modal?.type==='deal' && <DealRoomModal
    deal={deals.find(d=>d.id===modal.data.id)||modal.data}
    onClose={()=>setModal(null)}
    user={user} isAdmin={user?.role==='admin'}
    onReport={reportDeal} onResume={resumeDeal} onReject={rejectDeal} onSend={sendMsg}/>}

  {filterOpen && (
    <div className="overlay" onClick={()=>setFilterOpen(false)}>
      <div className="modal" onClick={e=>e.stopPropagation()}>
        <div className="modal-head">
          <h3>Filters</h3>
          <button className="close-btn" onClick={()=>setFilterOpen(false)} aria-label="Close"><Icon name="x" size={18}/></button>
        </div>
        <div className="modal-body">
          <FilterPanel draft={draft} setDraft={setDraft}
            onApply={()=>{setApplied(draft);setFilterOpen(false);}}
            onReset={()=>{setDraft(emptyFilters);setApplied(emptyFilters);}}
            count={filtered.length}/>
        </div>
      </div>
    </div>
  )}

  {toast && <div className="toast" role="status">{toast}</div>}

  <style>{`
    @media(min-width:960px){
      .market-layout{grid-template-columns:270px minmax(0,1fr)!important}
    }
  `}</style>
</>
);
}
ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>
</body>
</html>

BEXORA MASTER BUILD SCRIPT 1 OF 5
PROJECT FOUNDATION, ARCHITECTURE, DATA MODEL AND GLOBAL REQUIREMENTS
You are the lead software architect and senior full-stack engineer responsible for building BEXORA, a production-oriented digital asset marketplace.
IMPORTANT: This is Script 1 of 5. Read and retain the requirements of all five scripts before making architectural decisions. The five scripts are one unified specification, not five separate applications. When all five scripts are supplied together, reconcile them and implement one consistent system.
1. EXISTING PROJECT INSPECTION
Before modifying anything:
Inspect all existing source files, dependencies, application routes, components, Firebase configuration, database structure, server endpoints, environment variables, tests and deployment configuration available in the current workspace.
Identify existing functionality that works, incomplete functionality, security vulnerabilities, duplicated code and incompatible architectural decisions.
Preserve working functionality unless modification is necessary to satisfy this specification.
Never assume a feature is implemented merely because its button or interface exists.
Do not destroy existing user data or replace the project with an unrelated starter template.
Produce an internal implementation plan covering all five scripts and then execute it.
If an existing implementation conflicts with this specification, prefer this specification while preserving compatible data and documenting any necessary migration.
Never fabricate successful builds, passing tests, Firebase deployments, payment integrations or external API verification.
Do not stop after creating a plan or a prototype. Implement the available work, run appropriate checks, and report remaining external setup requirements honestly.
2. PRODUCT IDENTITY
Product name: BEXORA.
Product type: A multilingual marketplace for buying and selling digital assets.
Supported asset categories include, but are not limited to:
YouTube channels.
Facebook pages and groups.
Instagram accounts.
TikTok accounts.
Telegram channels and groups.
Websites and online businesses.
Domains.
Gaming accounts, including Free Fire and PUBG-related accounts where lawful and permitted.
Other digital assets created and managed through the administrator's category system.
Important: Every platform, category, asset field, verification requirement and monetization type must be configurable. Do not hardcode the application so that new platforms require rebuilding the entire frontend.
Implement a clean, modern, responsive social-marketplace experience suitable for mobile, tablet and desktop.
3. REQUIRED TECHNOLOGY
Use Firebase as the primary backend infrastructure:
Firebase Authentication.
Cloud Firestore.
Firebase Cloud Functions using a supported runtime.
Firebase Storage with private-file access rules.
Firebase App Check where supported.
Firebase Hosting or an appropriate managed cloud hosting service.
Firebase Security Rules.
Firebase scheduled functions and backup automation where supported.
Secure server-side integrations for AI, payments, email and other external providers.
Use the existing frontend stack when it is compatible. If creating or modernizing the application, use a maintainable TypeScript-based React architecture with reusable components and an appropriate build system.
Do not introduce an unnecessary second database or backend framework. If a separate backend becomes necessary for a concrete technical requirement, explain why and keep the architecture consistent.
Use environment-specific configuration for development, staging and production.
4. APPLICATION ARCHITECTURE
Organize the application into clearly separated modules:
Public marketplace.
Authentication and account management.
User profiles and verification.
Listings and listing moderation.
Bidding and Buy Now.
Monetization metadata and evidence verification.
Search, filters and recommendations.
Pre-sale messaging.
Escrow and transaction state management.
Private deal rooms.
Payments and provider adapters.
Seller balances and withdrawals.
Earn tasks and reward verification.
Reports, support and notifications.
Administrator dashboard.
Superadministrator controls.
Audit logging.
Storage and retention management.
Security monitoring.
Backup and recovery.
Automated tests and deployment.
Create shared type definitions and validation schemas so frontend and backend use consistent field names and allowed values.
Use explicit loading, empty, success, validation-error and failure states throughout the interface.
5. CORE DATA MODEL
Design and document Firestore collections and relationships before implementing business logic. Use appropriate document IDs, timestamps, indexes, access controls and pagination.
Include collections or equivalent structures for:
users
publicProfiles
privateUserData
identityVerifications
categories
platforms
monetizationTypes
listings
listingImages
listingEvidence
listingVerificationJobs
listingVerificationResults
bids
favorites
follows
deals
dealParticipants
dealMessages
dealEvents
disputes
payments
paymentWebhookEvents
escrowRecords
wallets
walletLedger
withdrawalMethods
withdrawalRequests
earnTasks
earnCompletions
reports
supportSettings
announcements
notifications
userNotificationPreferences
adminSettings
administratorPermissions
auditLogs
moderationCases
backupRecords
systemHealthEvents
You may consolidate or add collections when justified, but preserve equivalent capabilities and document the final schema.
Use server-generated timestamps. Never trust client-provided prices, wallet balances, administrator roles, payment status, verification results or transaction states.
For monetary amounts, use integer minor units wherever possible, with an explicit currency code. Avoid floating-point calculations for financial operations.
Use atomic Firestore transactions or batched operations where appropriate. Design idempotent server functions so retries do not create duplicate payments, credits, purchases or wallet entries.
6. SECURITY PRINCIPLES
Implement:
Least-privilege authorization.
Firebase Authentication and verified account claims where appropriate.
Server-enforced authorization for every privileged operation.
Role-based access control.
Field-level protection for sensitive records through backend access patterns and appropriate rules.
Private identity documents.
Private listing evidence when public access is not justified.
Rate limiting and abuse prevention for sensitive endpoints.
App Check where compatible.
Input validation and output encoding.
Secure file type and size validation.
Audit logging.
Secret management through server-side environment configuration or an appropriate secret manager.
Protection against IDOR, privilege escalation, mass assignment, replay, duplicate webhook events and unauthorized Firestore access.
Do not place service-account credentials, payment secrets, AI API keys or other privileged secrets in client-side JavaScript, public repositories or downloadable configuration files.
Never rely on hiding a button in the UI as an authorization mechanism.
7. BUSINESS RULES
Users may browse public listings without logging in.
Registration is free.
Login is required for bidding, buying, selling, following, participating in private chats, earning rewards and other protected actions.
Sellers may trade without mandatory NID verification, subject to applicable law and risk controls.
The buyer fee is administrator-configurable.
Seller commission is initially 0%.
Seller withdrawals are manually reviewed and processed by administrators.
The system must support BDT and USD, with administrator-controlled currency configuration and exchange-rate settings.
Live payments must remain disabled until the relevant provider credentials, merchant approval, webhook configuration and production checks are completed.
No feature may falsely claim that an account, payment, listing or external platform status has been verified.
8. COMPLETION REQUIREMENTS
Before declaring implementation complete:
Create a technical architecture document.
