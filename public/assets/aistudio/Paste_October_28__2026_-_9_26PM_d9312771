            <div className="stack" style={{gap:14}}>
              {Object.entries(MONETIZATION).map(([p,arr])=>(
                <div key={p}>
                  <div className="row" style={{gap:8,marginBottom:6}}>
                    <PlatformIcon id={p} size={16} style={{color:'var(--purple)'}}/>
                    <b className="sm">{PLATFORM_META[p].name}</b>
                  </div>
                  {arr.map(o=>{
                    const enabled = monetizationConfig[o.id] !== false;
                    return (
                      <label key={o.id} className={'check'+(enabled?' on':'')} style={{marginBottom:6}}>
                        <input type="checkbox" checked={enabled} onChange={()=>onToggleMonetization(o.id)}/>
