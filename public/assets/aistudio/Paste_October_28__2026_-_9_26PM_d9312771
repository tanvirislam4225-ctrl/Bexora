Bexora

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>BEXORA — Digital Asset Marketplace</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ============================= DESIGN TOKENS ============================= */
:root{
--bg:#FFF9F1; --bg-2:#FFF3E4; --surface:#FFFFFF; --surface-2:#FFF6EC; --surface-3:#FFEFDD;
--text:#191919; --text-2:#656565; --text-3:#8C8578;
--border:#191919; --border-soft:#EADFCF; --border-strong:#191919;
--orange:#FF6500; --orange-soft:#FFE8D6; --yellow:#FFD400; --yellow-soft:#FFF4BF;
--purple:#793A91; --purple-soft:#F3E7F8; --teal:#12897B; --teal-soft:#DCF4F0;
--green:#1C7C4A; --green-soft:#DCF3E6; --red:#C3341F; --red-soft:#FCE3DE;
--shadow-color:#191919; --shadow:4px 4px 0 var(--shadow-color); --shadow-sm:2px 2px 0 var(--shadow-color);
--r-sm:10px; --r:14px; --r-lg:20px; --r-xl:28px;
--font:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
color-scheme:light;
}
[data-theme="dark"]{
--bg:#0D0D10; --bg-2:#111116; --surface:#17171C; --surface-2:#1E1E25; --surface-3:#242430;
--text:#F6F3EE; --text-2:#A9A6B3; --text-3:#85828F;
--border:#2B2B36; --border-soft:#262631; --border-strong:#793A91;
--orange:#FF7A26; --orange-soft:#3A2214; --yellow:#FFD400; --yellow-soft:#3A3310;
--purple:#B07AD0; --purple-soft:#2A1B33; --teal:#4DD6C8; --teal-soft:#12312E;
--green:#5FD99B; --green-soft:#12301F; --red:#FF8A72; --red-soft:#38160F;
--shadow-color:rgba(121,58,145,.55); --shadow:4px 4px 0 var(--shadow-color); --shadow-sm:2px 2px 0 var(--shadow-color);
color-scheme:dark;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{overflow-x:hidden;max-width:100%}
html{-webkit-text-size-adjust:100%}
body{
font-family:var(--font); background:var(--bg); color:var(--text);
-webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
transition:background .25s ease,color .25s ease; min-height:100vh;
padding-bottom:env(safe-area-inset-bottom);
}
img,svg{display:block;max-width:100%}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--purple);outline-offset:2px;border-radius:6px}
::selection{background:var(--yellow);color:#191919}
/* ============================= LAYOUT ============================= */
.wrap{width:100%;max-width:1240px;margin:0 auto;padding:0 16px}
@media(min-width:768px){.wrap{padding:0 28px}}
.page{padding:22px 0 40px;min-height:60vh}
.row{display:flex;align-items:center;gap:10px}
.row-between{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.grid{display:grid;gap:14px}
.stack{display:flex;flex-direction:column;gap:14px}
.muted{color:var(--text-2)}
.tiny{font-size:12px}
.sm{font-size:13.5px}
.center{text-align:center}
.hide-mobile{display:none}
@media(min-width:768px){.hide-mobile{display:block}.show-mobile{display:none!important}}
/* ============================= TYPE ============================= */
h1{font-size:clamp(28px,5.2vw,52px);line-height:1.08;letter-spacing:-.03em;font-weight:800}
h2{font-size:clamp(20px,3vw,28px);line-height:1.15;letter-spacing:-.02em;font-weight:800}
h3{font-size:clamp(15px,2vw,18px);line-height:1.25;letter-spacing:-.01em;font-weight:700}
.eyebrow{font-size:11.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--orange)}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap}
/* ============================= BUTTONS ============================= */
.btn{
display:inline-flex;align-items:center;justify-content:center;gap:8px;
padding:11px 18px;border-radius:var(--r-sm);font-weight:700;font-size:14px;
border:2px solid var(--border-strong);background:var(--surface);color:var(--text);
box-shadow:var(--shadow-sm);transition:transform .12s ease,box-shadow .12s ease,background .18s ease,color .18s ease;
min-height:44px;line-height:1;white-space:nowrap;
}
.btn:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--shadow-color)}
.btn:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--shadow-color)}
.btn-primary{background:var(--orange);color:#fff;border-color:var(--border-strong)}
[data-theme="dark"] .btn-primary{color:#141414}
.btn-yellow{background:var(--yellow);color:#191919;border-color:var(--border-strong)}
.btn-purple{background:var(--purple);color:#fff;border-color:var(--border-strong)}
[data-theme="dark"] .btn-purple{color:#0D0D10}
.btn-ghost{background:transparent;border-color:transparent;box-shadow:none;color:var(--text-2)}
.btn-ghost:hover{background:var(--surface-2);color:var(--text);box-shadow:none;transform:none}
.btn-sm{padding:8px 12px;font-size:12.5px;min-height:36px;border-radius:9px}
.btn-block{width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important;box-shadow:var(--shadow-sm)!important}
.icon-btn{
width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;
border-radius:12px;border:2px solid var(--border-strong);background:var(--surface);
box-shadow:var(--shadow-sm);transition:transform .12s ease,box-shadow .12s ease;color:var(--text);
}
.icon-btn:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--shadow-color)}
.icon-btn:active{transform:translate(2px,2px);box-shadow:none}
/* ============================= CARDS / SURFACES ============================= */
.card{
background:var(--surface);border:2px solid var(--border-strong);border-radius:var(--r);
box-shadow:var(--shadow);transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease;
}
[data-theme="dark"] .card{border-width:1px;border-color:var(--border)}
.card-pad{padding:16px}
@media(min-width:768px){.card-pad{padding:20px}}
.soft{background:var(--surface-2);border:1px solid var(--border-soft);border-radius:var(--r);padding:14px}
.chip{
display:inline-flex;align-items:center;gap:6px;padding:6px 11px;border-radius:999px;
font-size:12px;font-weight:700;border:1.5px solid var(--border-soft);background:var(--surface-2);color:var(--text-2);
}
.chip-on{background:var(--orange);border-color:var(--border-strong);color:#fff}
[data-theme="dark"] .chip-on{color:#141414;border-color:var(--border-strong)}
.chip-verified{background:var(--green-soft);border-color:transparent;color:var(--green)}
.chip-claimed{background:var(--yellow-soft);border-color:transparent;color:#7A6300}
[data-theme="dark"] .chip-claimed{color:var(--yellow)}
.chip-purple{background:var(--purple-soft);border-color:transparent;color:var(--purple)}
.chip-red{background:var(--red-soft);border-color:transparent;color:var(--red)}
.chip-teal{background:var(--teal-soft);border-color:transparent;color:var(--teal)}
.badge{
display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:7px;
font-size:11px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;
}
/* ============================= FORMS ============================= */
.field{display:flex;flex-direction:column;gap:6px;min-width:0}
.label{font-size:12.5px;font-weight:800;color:var(--text-2);letter-spacing:.02em}
.input,.select,.textarea{
width:100%;padding:11px 13px;border-radius:var(--r-sm);border:2px solid var(--border-soft);
background:var(--surface);color:var(--text);font-size:14px;min-height:44px;
transition:border-color .16s ease,box-shadow .16s ease;
}
.input:focus,.select:focus,.textarea:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px var(--purple-soft)}
.textarea{min-height:110px;resize:vertical;line-height:1.5}
.input::placeholder,.textarea::placeholder{color:var(--text-3)}
.input.err,.select.err{border-color:var(--red);box-shadow:0 0 0 3px var(--red-soft)}
.hint{font-size:11.5px;color:var(--text-3);line-height:1.45}
.err-msg{font-size:12px;color:var(--red);font-weight:700}
.check{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:var(--r-sm);
border:2px solid var(--border-soft);background:var(--surface);cursor:pointer;transition:all .15s ease}
.check:hover{border-color:var(--purple)}
.check.on{border-color:var(--purple);background:var(--purple-soft)}
.check input{margin-top:2px;accent-color:var(--purple);width:17px;height:17px;flex:none}
.seg{display:flex;gap:6px;padding:5px;background:var(--surface-2);border-radius:12px;border:1px solid var(--border-soft);flex-wrap:wrap}
.seg button{
flex:1 1 auto;min-width:0;padding:9px 12px;border-radius:8px;font-size:13px;font-weight:700;
color:var(--text-2);transition:all .16s ease;white-space:nowrap;
}
.seg button.on{background:var(--surface);color:var(--text);box-shadow:0 1px 4px rgba(0,0,0,.12)}
/* ============================= NAVBAR ============================= */
.navbar{
position:sticky;top:0;z-index:60;background:color-mix(in srgb,var(--bg) 88%,transparent);
backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
border-bottom:2px solid var(--border-strong);padding-top:env(safe-area-inset-top);
}
[data-theme="dark"] .navbar{border-bottom:1px solid var(--border)}
.navbar-in{display:flex;align-items:center;gap:12px;height:64px;min-height:64px}
.logo{display:flex;align-items:center;gap:9px;font-weight:800;font-size:19px;letter-spacing:-.03em;flex:none}
.logo-mark{
width:32px;height:32px;border-radius:9px;display:grid;place-items:center;flex:none;
background:var(--orange);border:2px solid var(--border-strong);color:#fff;font-size:15px;font-weight:800;
box-shadow:2px 2px 0 var(--shadow-color);
}
[data-theme="dark"] .logo-mark{color:#141414}
.nav-links{display:none;align-items:center;gap:2px;margin-left:10px}
@media(min-width:960px){.nav-links{display:flex}}
.nav-link{padding:9px 13px;border-radius:9px;font-size:13.5px;font-weight:700;color:var(--text-2);transition:all .16s ease;white-space:nowrap}
.nav-link:hover{background:var(--surface-2);color:var(--text)}
.nav-link.on{background:var(--orange);color:#fff;box-shadow:var(--shadow-sm);border:1.5px solid var(--border-strong)}
[data-theme="dark"] .nav-link.on{color:#141414}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:8px}
.nav-search{display:none;align-items:center;gap:8px;flex:1;max-width:300px;margin-left:14px}
@media(min-width:1100px){.nav-search{display:flex}}
.search-box{display:flex;align-items:center;gap:8px;background:var(--surface-2);border:1.5px solid var(--border-soft);
border-radius:11px;padding:0 12px;height:42px;width:100%;transition:border-color .16s}
.search-box:focus-within{border-color:var(--purple)}
.search-box input{border:0;background:none;outline:none;width:100%;font-size:13.5px;min-width:0}
.drawer{
position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.5);backdrop-filter:blur(3px);
display:flex;justify-content:flex-end;animation:fade .2s ease;
}
.drawer-panel{
width:min(340px,88vw);height:100%;background:var(--bg);border-left:2px solid var(--border-strong);
padding:18px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;animation:slideIn .24s cubic-bezier(.2,.9,.3,1);
}
@keyframes slideIn{from{transform:translateX(100%)}to{transform:translateX(0)}}
@keyframes fade{from{opacity:0}to{opacity:1}}
/* ============================= BOTTOM NAV ============================= */
.bottomnav{
position:fixed;left:0;right:0;bottom:0;z-index:70;display:grid;grid-template-columns:repeat(5,1fr);
background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(16px);
border-top:2px solid var(--border-strong);padding-bottom:env(safe-area-inset-bottom);
}
[data-theme="dark"] .bottomnav{border-top:1px solid var(--border)}
@media(min-width:768px){.bottomnav{display:none}}
.bn-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
padding:9px 2px 8px;font-size:10px;font-weight:700;color:var(--text-3);transition:color .16s;min-height:56px}
.bn-item.on{color:var(--orange)}
.bn-item.on svg{transform:translateY(-1px)}
.bn-dot{width:5px;height:5px;border-radius:50%;background:transparent}
.bn-item.on .bn-dot{background:var(--orange)}
main{padding-bottom:76px}
@media(min-width:768px){main{padding-bottom:0}}
/* ============================= HERO ============================= */
.hero{
position:relative;overflow:hidden;border-radius:var(--r-xl);
border:2px solid var(--border-strong);box-shadow:var(--shadow);
background:radial-gradient(1100px 460px at 12% -10%,var(--orange-soft),transparent 60%),
radial-gradient(900px 420px at 92% 8%,var(--purple-soft),transparent 62%),
var(--surface);
padding:26px 18px;
}
@media(min-width:768px){.hero{padding:52px 44px}}
.hero h1{max-width:16ch}
.hero .hl{color:var(--orange);position:relative;white-space:nowrap}
.hero-search{display:flex;gap:8px;margin-top:20px;max-width:560px;flex-wrap:wrap}
.hero-search .search-box{height:48px;background:var(--surface);border:2px solid var(--border-soft);flex:1 1 200px}
.hero-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:22px;max-width:520px}
.stat{padding:10px 12px;border-radius:12px;background:var(--surface);border:2px solid var(--border-soft)}
.stat b{display:block;font-size:clamp(15px,2.4vw,20px);font-weight:800;letter-spacing:-.02em}
.stat span{font-size:11px;color:var(--text-2);font-weight:600}
/* ============================= PLATFORM / CATEGORY GRID ============================= */
.cat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
@media(min-width:520px){.cat-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:11px}}
@media(min-width:768px){.cat-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}}
@media(min-width:1080px){.cat-grid{grid-template-columns:repeat(8,minmax(0,1fr))}}
.cat-card{
aspect-ratio:1/1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;
border-radius:16px;border:1.5px solid var(--purple);background:var(--surface);
color:var(--text);padding:8px;transition:transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease;
min-width:0;position:relative;
}
[data-theme="light"] .cat-card{background:var(--surface);border-color:#E2CFEC;box-shadow:0 2px 0 rgba(121,58,145,.14)}
.cat-card:hover{transform:translateY(-2px);border-color:var(--purple);box-shadow:0 6px 16px rgba(121,58,145,.16)}
.cat-card.on{background:var(--purple-soft);border-color:var(--purple);border-width:2px}
.cat-card .pico{width:clamp(20px,5.4vw,30px);height:clamp(20px,5.4vw,30px);color:var(--purple)}
.cat-card .clabel{font-size:clamp(9.5px,2.1vw,11.5px);font-weight:700;text-align:center;line-height:1.15;
overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.cat-card .ccount{position:absolute;top:5px;right:6px;font-size:9px;font-weight:800;color:var(--purple);opacity:.75}
@media(min-width:768px){.cat-card{border-radius:18px}}
/* ============================= LISTING CARDS ============================= */
.listings{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr));gap:14px}
@media(min-width:640px){.listings{gap:16px}}
.lcard{
display:flex;flex-direction:column;background:var(--surface);border:2px solid var(--border-strong);
border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow-sm);cursor:pointer;
transition:transform .16s ease,box-shadow .16s ease;min-width:0;
}
[data-theme="dark"] .lcard{border-width:1px;border-color:var(--border)}
.lcard:hover{transform:translate(-2px,-2px);box-shadow:var(--shadow)}
.lc-media{position:relative;aspect-ratio:16/10;display:grid;place-items:center;overflow:hidden}
.lc-media .glyph{width:clamp(34px,10vw,52px);height:clamp(34px,10vw,52px);color:#fff;opacity:.96;filter:drop-shadow(0 3px 8px rgba(0,0,0,.25))}
.lc-media::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 30% 20%,rgba(255,255,255,.28),transparent 55%)}
.lc-top{position:absolute;top:8px;left:8px;right:8px;display:flex;justify-content:space-between;gap:6px;z-index:2}
.lc-pill{background:rgba(255,255,255,.94);color:#191919;border-radius:7px;padding:4px 8px;font-size:10px;
font-weight:800;letter-spacing:.03em;text-transform:uppercase;backdrop-filter:blur(4px)}
.lc-body{padding:12px;display:flex;flex-direction:column;gap:8px;flex:1;min-width:0}
.lc-title{font-size:14.5px;font-weight:800;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;
-webkit-box-orient:vertical;overflow:hidden;letter-spacing:-.01em}
.lc-meta{display:flex;flex-wrap:wrap;gap:4px 10px;font-size:11.5px;color:var(--text-2);font-weight:600}
.lc-meta span{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.lc-chips{display:flex;flex-wrap:wrap;gap:5px}
.lc-foot{margin-top:auto;padding-top:10px;border-top:1px dashed var(--border-soft);
display:flex;align-items:center;justify-content:space-between;gap:8px}
.lc-price{font-size:16px;font-weight:800;letter-spacing:-.02em;white-space:nowrap}
.lc-price small{font-size:10.5px;font-weight:700;color:var(--text-2);display:block;letter-spacing:.02em}
.avatar{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;flex:none;
font-size:11px;font-weight:800;color:#fff;border:1.5px solid var(--border-strong)}
.seller-line{display:flex;align-items:center;gap:6px;min-width:0}
.seller-line span{font-size:11.5px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* ============================= MODALS ============================= */
.overlay{
position:fixed;inset:0;z-index:100;background:rgba(10,8,14,.62);backdrop-filter:blur(4px);
display:flex;align-items:flex-end;justify-content:center;padding:0;animation:fade .18s ease;
}
@media(min-width:640px){.overlay{align-items:center;padding:24px}}
.modal{
width:100%;max-width:720px;max-height:92vh;overflow-y:auto;background:var(--bg);
border:2px solid var(--border-strong);border-radius:var(--r-xl) var(--r-xl) 0 0;
box-shadow:0 -8px 40px rgba(0,0,0,.3);animation:sheetUp .26s cubic-bezier(.2,.9,.3,1);
padding-bottom:env(safe-area-inset-bottom);
}
@media(min-width:640px){.modal{border-radius:var(--r-xl);max-height:88vh;box-shadow:var(--shadow);animation:pop .2s ease}}
@keyframes sheetUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes pop{from{transform:scale(.97);opacity:.4}to{transform:scale(1);opacity:1}}
.modal-head{
position:sticky;top:0;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:10px;
padding:14px 16px;background:var(--bg);border-bottom:2px solid var(--border-soft);
}
.modal-head h3{font-size:16px}
.modal-body{padding:16px}
@media(min-width:640px){.modal-body{padding:20px}}
.close-btn{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;
background:var(--surface-2);color:var(--text-2);border:1.5px solid var(--border-soft)}
.close-btn:hover{color:var(--text);border-color:var(--border-strong)}
/* ============================= MISC ============================= */
.divider{height:1px;background:var(--border-soft);margin:12px 0}
.stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
@media(min-width:640px){.stat-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
.kpi{padding:14px;border-radius:var(--r);background:var(--surface);border:2px solid var(--border-soft)}
.kpi b{display:block;font-size:clamp(18px,3vw,24px);font-weight:800;letter-spacing:-.02em}
.kpi span{font-size:11px;color:var(--text-2);font-weight:700;text-transform:uppercase;letter-spacing:.06em}
.empty{display:flex;flex-direction:column;align-items:center;gap:10px;padding:44px 18px;text-align:center;color:var(--text-2)}
.empty .eico{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;background:var(--surface-2);color:var(--text-3)}
.toast{
position:fixed;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom));z-index:200;
background:var(--text);color:var(--bg);padding:12px 18px;border-radius:12px;font-size:13.5px;font-weight:700;
box-shadow:0 8px 30px rgba(0,0,0,.28);max-width:min(420px,92vw);animation:toastIn .25s ease;
}
@media(min-width:768px){.toast{bottom:26px}}
@keyframes toastIn{from{transform:translate(-50%,14px);opacity:0}to{transform:translate(-50%,0);opacity:1}}
.support-fab{
position:fixed;right:16px;bottom:calc(72px + env(safe-area-inset-bottom));z-index:80;
width:52px;height:52px;border-radius:50%;display:grid;place-items:center;
