.timer{display:flex;gap:8px;flex-wrap:wrap}
.tunit{flex:1 1 62px;min-width:62px;text-align:center;padding:10px 6px;border-radius:12px;
background:var(--surface-2);border:1.5px solid var(--border-soft)}
.tunit b{display:block;font-size:clamp(16px,4vw,22px);font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.tunit span{font-size:9.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2)}
