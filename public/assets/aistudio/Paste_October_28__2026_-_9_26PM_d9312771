/* =========================================================================
COUNTDOWN
========================================================================= */
function Countdown({deadline, big}) {
const [left,setLeft] = useState(Math.max(0,deadline-Date.now()));
useEffect(()=>{
const t = setInterval(()=>setLeft(Math.max(0,deadline-Date.now())),1000);
return ()=>clearInterval(t);
},[deadline]);
const s = Math.floor(left/1000);
const d = Math.floor(s/86400), h = Math.floor((s%86400)/3600), m = Math.floor((s%3600)/60), sec = s%60;
const units = [[d,'Days'],[h,'Hours'],[m,'Min'],[sec,'Sec']];
const expired = left<=0;
return (
<div className="timer" role="timer" aria-live="off">
{units.map(([v,l])=>(
<div className="tunit" key={l} style={expired?{borderColor:'var(--red)'}:{}}>
<b style={expired?{color:'var(--red)'}:{}}>{String(v).padStart(2,'0')}</b>
<span>{l}</span>
</div>
))}
</div>
);
}
