transition:transform .16s ease;
}
[data-theme="dark"] .support-fab{color:#141414}
@media(min-width:768px){.support-fab{bottom:24px;right:24px}}
.support-fab:hover{transform:translate(-1px,-2px)}
.support-panel{
position:fixed;right:14px;bottom:calc(132px + env(safe-area-inset-bottom));z-index:85;width:min(300px,92vw);
background:var(--surface);border:2px solid var(--border-strong);border-radius:var(--r-lg);
