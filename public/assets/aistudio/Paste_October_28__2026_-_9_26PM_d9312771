                      </label>
                    );
                  })}
                </div>
              ))}
            </div>
          </div>
        )}

        {section==='support' && (
          <div className="card card-pad">
            <h3 style={{marginBottom:4}}>Support contact settings</h3>
            <p className="hint" style={{marginBottom:14}}>These values power the floating support button across the site. Leave blank to disable an option.</p>
            <div className="stack" style={{gap:12}}>
              <div className="field">
                <label className="label">WhatsApp support number</label>
                <input className="input" value={support.whatsapp} onChange={e=>setSupport(s=>({...s,whatsapp:e.target.value}))} placeholder="+8801XXXXXXXXX"/>
                <span className="hint">Digits only with country code. Used to build a wa.me link.</span>
              </div>
              <div className="field">
                <label className="label">Telegram support link</label>
                <input className="input" value={support.telegram} onChange={e=>setSupport(s=>({...s,telegram:e.target.value}))} placeholder="https://t.me/yourhandle"/>
              </div>
              <div className="field">
                <label className="label">Support email address</label>
                <input className="input" value={support.email} onChange={e=>setSupport(s=>({...s,email:e.target.value}))} placeholder="support@yourdomain.com"/>
              </div>
              <button className="btn btn-primary" onClick={()=>{
                const clean = {
                  whatsapp:support.whatsapp.replace(/[^\d]/g,''),
                  telegram:/^https:\/\/t\.me\//.test(support.telegram)?support.telegram:'',
                  email:/^\S+@\S+\.\S+$/.test(support.email)?support.email:'',
                };
                setSupport(clean);
                onSaveSettings({...settings, support:clean});
                flash('Support contacts updated — live on the site now.');
              }}>Save support settings</button>
              <p className="hint">These are public contact details only. Never enter account passwords, OTPs or private credentials.</p>
            </div>
          </div>
        )}

        {section==='settings' && (
          <div className="card card-pad">
            <h3 style={{marginBottom:4}}>Payment & fee settings</h3>
            <p className="hint" style={{marginBottom:14}}>Manual payment receiving numbers. Gateway integrations remain disabled until configured.</p>
            <div className="stack" style={{gap:12}}>
              {[['bkash','bKash number'],['nagad','Nagad number'],['rocket','Rocket number']].map(([k,label])=>(
                <div className="field" key={k}>
                  <label className="label">{label}</label>
                  <input className="input" value={pay[k]} onChange={e=>setPay(p=>({...p,[k]:e.target.value}))} placeholder="01XXXXXXXXX"/>
                </div>
              ))}
              <button className="btn btn-primary" onClick={()=>{
                onSaveSettings({...settings, payments:pay});
                flash('Payment numbers saved.');
              }}>Save payment numbers</button>
              <div className="divider"/>
              <div className="row-between soft"><span className="sm">Buyer fee</span><b>{settings.buyerFeePct}%</b></div>
              <div className="row-between soft"><span className="sm">Seller commission</span><b>{settings.sellerCommission}%</b></div>
              <div className="row-between soft"><span className="sm">Live payment gateways</span><span className="badge chip-red">Disabled</span></div>
              <div className="row-between soft"><span className="sm">Email delivery (SMTP)</span><span className="badge chip-red">Not configured</span></div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
  {toast && <div className="toast">{toast}</div>}
</div>
);
}
/* =========================================================================
APP
========================================================================= */
function App() {
const [theme,setTheme] = useState(()=>localStorage.getItem('bx_theme')||'light');
const [page,setPage] = useState('home');
const [user,setUser] = useState(null);
const [listings,setListings] = useState(SEED_LISTINGS);
const [deals,setDeals] = useState(SEED_DEALS);
const [wallet,setWallet] = useState({balance:0,deposits:[],purchases:[]});
const [settings,setSettings] = useState({
support:{whatsapp:'',telegram:'',email:''},
payments:{bkash:'',nagad:'',rocket:''},
buyerFeePct:3, sellerCommission:0
});
const [monetizationConfig,setMonetizationConfig] = useState({});
const [modal,setModal] = useState(null);
const [toast,setToast] = useState('');
const [drawer,setDrawer] = useState(false);
const [supportOpen,setSupportOpen] = useState(false);
const [search,setSearch] = useState('');
const emptyFilters = {platform:'all',monetization:'all',methods:[],minPrice:'',maxPrice:'',
minMetric:'',maxMetric:'',minRevenue:'',maxRevenue:'',verifiedSeller:false,sort:'newest'};
const [draft,setDraft] = useState(emptyFilters);
const [applied,setApplied] = useState(emptyFilters);
const [filterOpen,setFilterOpen] = useState(false);
useEffect(()=>{
document.documentElement.dataset.theme = theme;
localStorage.setItem('bx_theme',theme);
},[theme]);
const flash = m => { setToast(m); clearTimeout(window.__bxT); window.__bxT = setTimeout(()=>setToast(''),2600); };
/* ---- filtering ---- */
const filtered = useMemo(()=>{
const f = applied;
let out = listings.filter(l=>l.status==='active');
if(search.trim()){
const q = search.toLowerCase();
out = out.filter(l=>l.title.toLowerCase().includes(q)||l.description.toLowerCase().includes(q));
}
if(f.platform!'all') out = out.filter(l=>l.platform===f.platform);
if(f.monetization==='monetized') out = out.filter(l=>l.monetizationStatus==='monetized');
if(f.monetization==='non') out = out.filter(l=>l.monetizationStatus!'monetized');
if(f.methods.length) out = out.filter(l=>l.monetizationOptions.some(m=>f.methods.includes(m)));
if(f.minPrice!'') out = out.filter(l=>l.price>=Number(f.minPrice));
if(f.maxPrice!'') out = out.filter(l=>l.price<=Number(f.maxPrice));
if(f.minMetric!'') out = out.filter(l=>l.metric>=Number(f.minMetric));
if(f.maxMetric!'') out = out.filter(l=>l.metric<=Number(f.maxMetric));
if(f.minRevenue!'') out = out.filter(l=>l.revenue>=Number(f.minRevenue));
if(f.maxRevenue!'') out = out.filter(l=>l.revenue<=Number(f.maxRevenue));
if(f.verifiedSeller) out = out.filter(l=>SELLERS[l.sellerId] && SELLERS[l.sellerId].verified);
const s = f.sort;
out = [...out].sort((a,b)=> s==='price-asc'?a.price-b.price : s==='price-desc'?b.price-a.price :
s==='popular'?b.views-a.views : s==='oldest'?a.createdAt-b.createdAt : b.createdAt-a.createdAt);
return out;
},[listings,applied,search]);
const activeChips = useMemo(()=>{
const c=[];
if(applied.platform!'all') c.push(['platform','Platform: '+PLATFORM_META[applied.platform].name]);
if(applied.monetization!'all') c.push(['monetization', applied.monetization==='monetized'?'Monetized':'Non-Monetized']);
applied.methods.forEach(m=>c.push(['method-'+m, optName(m)]));
if(applied.minPrice!'') c.push(['minPrice','Min '+money(Number(applied.minPrice))]);
if(applied.maxPrice!'') c.push(['maxPrice','Max '+money(Number(applied.maxPrice))]);
if(applied.minMetric!'') c.push(['minMetric','Metric ≥ '+fmt(Number(applied.minMetric))]);
if(applied.maxMetric!'') c.push(['maxMetric','Metric ≤ '+fmt(Number(applied.maxMetric))]);
if(applied.minRevenue!'') c.push(['minRevenue','Revenue ≥ '+money(Number(applied.minRevenue))]);
if(applied.maxRevenue!'') c.push(['maxRevenue','Revenue ≤ '+money(Number(applied.maxRevenue))]);
if(applied.verifiedSeller) c.push(['verifiedSeller','Verified sellers']);
return c;
},[applied]);
const removeChip = key => {
let next = {...applied};
if(key.startsWith('method-')) next.methods = applied.methods.filter(m=>m!==key.slice(7));
else if(key==='platform') { next.platform='all'; next.methods=[]; }
else next[key] = key==='verifiedSeller'?false:'';
setApplied(next); setDraft(next);
};
/* ---- actions ---- */
const openListing = l => {
setListings(ls=>ls.map(x=>x.id===l.id?{...x,views:x.views+1}:x));
setModal({type:'listing',data:l});
};
const buyNow = (l,total) => {
if(!user){ setModal({type:'auth'}); return; }
if(wallet.balance < total){
flash('Insufficient wallet balance. Add funds to continue.');
setModal({type:'wallet'});
return;
}
setWallet(w=>({
...w,
balance: w.balance - total,
purchases:[{id:'P'+Date.now(),title:l.title,amount:total,at:Date.now()},...w.purchases]
}));
const deal = {
id:'D'+Math.random().toString(36).slice(2,7).toUpperCase(),
listingId:l.id, title:l.title, amount:total, buyer:user.name, seller:(SELLERS[l.sellerId]||{}).name||'Seller',
status:'protection', confirmedAt:Date.now(), durationHours:48, reports:[],
messages:[], events:[{t:Date.now(),label:'Purchase completed with wallet — buyer confirmed receipt, protection timer started'}]
};
setDeals(d=>[deal,...d]);
setListings(ls=>ls.map(x=>x.id===l.id?{...x,status:'sold'}:x));
setModal({type:'deal',data:deal});
flash('Purchase complete. Funds are held in escrow.');
};
const placeBid = (id,amount) => {
setListings(ls=>ls.map(l=>l.id===id?{...l,bids:[...(l.bids||[]),{amount,user:user.email,at:Date.now()}]}:l));
setModal(null);
flash('Bid placed successfully.');
};
const messageSeller = l => {
if(!user){ setModal({type:'auth'}); return; }
setModal({type:'deal',data:{
id:'MSG-'+l.id, title:l.title, amount:l.price, buyer:user.name, seller:(SELLERS[l.sellerId]||{}).name||'Seller',
status:'protection', confirmedAt:Date.now(), durationHours:48, reports:[],
messages:[{id:'n1',from:'buyer',text:'Hi, I am interested in this listing. Could you share transfer details?',at:Date.now()}],
events:[{t:Date.now(),label:'Conversation started from listing page'}]
}});
flash('Reminder: never share passwords, OTPs or recovery codes in chat.');
};
const submitDeposit = d => {
setWallet(w=>({...w,deposits:[{...d,id:'DEP'+Date.now(),status:'pending',at:Date.now()},...w.deposits]}));
flash('Deposit request submitted — pending administrator approval.');
};
const decideDeposit = (id,status) => {
setWallet(w=>{
const dep = w.deposits.find(d=>d.id===id);
if(!dep || dep.status!=='pending') return w; // idempotent guard
return {
...w,
balance: status==='approved' ? w.balance+dep.amount : w.balance,
deposits: w.deposits.map(d=>d.id===id?{...d,status,reason: status==='rejected'?'Payment could not be verified.':''}:d)
};
});
};
const reportDeal = id => {
setDeals(ds=>ds.map(d=>d.id===id?{...d,status:'under-review',
reports:[...d.reports,{reason:'Buyer reported a transfer issue',by:'buyer',at:Date.now()}],
events:[...d.events,{t:Date.now(),label:'Issue reported — under admin review (deadline unchanged)'}]}:d));
flash('Report submitted. The deadline will not be extended.');
};
const resumeDeal = id => {
setDeals(ds=>ds.map(d=>d.id===id?{...d,status:'protection',
events:[...d.events,{t:Date.now(),label:'Admin resumed the deal — original deadline preserved'}]}:d));
flash('Deal resumed.');
};
const rejectDeal = id => {
setDeals(ds=>ds.map(d=>d.id===id?{...d,status:'refunded',
events:[...d.events,{t:Date.now(),label:'Admin rejected the deal — buyer refunded'}]}:d));
flash('Deal rejected and buyer refunded.');
};
const sendMsg = (id,text) => {
if(/\b\d{5,}\b/.test(text) || /password|otp|recovery code/i.test(text)){
flash('Message blocked: never share passwords, OTPs, phone numbers or recovery codes.');
return;
}
setDeals(ds=>ds.map(d=>d.id===id?{...d,messages:[...d.messages,{id:'m'+Date.now(),from:'buyer',text,at:Date.now()}]}:d));
};
const nav = [
['home','Home','home'],
['market','Marketplace','grid'],
['sellers','Top Sellers','users'],
['earn','Earn','gift'],
['deals','Deals','chat'],
];
const topSellers = useMemo(()=>Object.values(SELLERS).sort((a,b)=>(b.completedb.rating)-(a.completeda.rating)),[]);
const earnings = [
{id:'e1',title:'Follow BEXORA on X',desc:'Visit our profile and follow for marketplace updates.',reward:15,status:'available'},
{id:'e2',title:'Watch the seller onboarding video',desc:'Complete the 4-minute walkthrough on listing safely.',reward:25,status:'available'},
{id:'e3',title:'Refer a verified seller',desc:'Reward is credited after partner postback confirms the referral.',reward:200,status:'verification-required'},
];
return (
<>
