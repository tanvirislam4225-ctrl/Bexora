    },
    "/withdrawals/{withdrawalId}": {
      "schema": "WithdrawalRequest",
      "description": "Seller payout withdrawal requests."
    },
    "/walletLedger/{entryId}": {
      "schema": "WalletLedgerEntry",
      "description": "Append-only wallet ledger entries."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Transaction-verified seller reviews."
    },
    "/publicConfig/{docId}": {
      "schema": "PublicSettings",
      "description": "Publicly readable platform configuration managed by admins."
    },
    "/aiProposals/{proposalId}": {
      "schema": "AiProposal",
      "description": "AI Developer proposals governed by human approval."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only administrative audit logs."
    },
    "/privateUsers/{userId}/pushTokens/{tokenId}": {
      "schema": "PushToken",
      "description": "Strictly owner-private FCM browser Web Push tokens."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Recipient-scoped notifications with immutable content and mark-as-read state updates."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Admin-managed platform announcements."
    },
    "/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "Strictly owner-private saved marketplace listings."
    },
    "/sellerFollows/{followId}": {
