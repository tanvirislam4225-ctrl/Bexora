  "firestore": {
    "/publicProfiles/{userId}": {
      "schema": "PublicProfile",
      "description": "Publicly readable user profiles isolated from PII."
    },
    "/privateUsers/{userId}": {
      "schema": "PrivateUser",
      "description": "Owner/Admin-only private user PII, verification statuses, and wallet balance."
    },
    "/usernames/{username}": {
      "schema": "UsernameReservation",
      "description": "Global case-insensitive username uniqueness index."
    },
    "/admins/{userId}": {
      "schema": "AdminRecord",
      "description": "Trusted administrator and superadmin registry."
    },
    "/identityVerifications/{userId}": {
      "schema": "IdentityVerification",
      "description": "Private NID front and back images restricted to owner and admin."
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Marketplace asset listings."
    },
