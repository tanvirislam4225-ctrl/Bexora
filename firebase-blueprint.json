        "completedTrader": { "type": "boolean" },
        "completedSales": { "type": "integer" },
        "completedPurchases": { "type": "integer" },
        "ratingSum": { "type": "integer" },
        "ratingCount": { "type": "integer" },
        "followerCount": { "type": "integer" },
