      "required": ["uid", "displayName", "username", "bio", "nidVerified", "completedTrader", "completedSales", "completedPurchases", "ratingSum", "ratingCount", "createdAt", "updatedAt"]
    },
    "PrivateUser": {
      "title": "PrivateUser",
